#!/usr/bin/env python3
"""A stand-in for tend that prints example sessions, for the README screenshot."""
import json, os, sys
home = os.path.expanduser("~")
p = lambda name: f"{home}/Projects/{name}"
def claude(status=None, question=None):
    return {"id": "claude", "name": "Claude", "icon": "com.anthropic.claudefordesktop",
            "status": status, "question": question}
def row(name, d, state, command, app=None, managed=True, autostart=True, named=True, resume=None):
    return {"name": name, "dir": d, "named_after_dir": named, "command": command, "resume": resume,
            "autostart": autostart, "managed": managed, "state": state, "attached": False, "app": app}
trust = {"id": "trust", "text": "Trust ~/Projects/notes in Claude Code? Sessions there can read, edit, and run files.",
         "answers": [{"id": "yes", "label": "Trust"}, {"id": "no", "label": "Don't trust"}]}
out = {
    "ls": [
        row("recipe-box", p("recipe-box"), "running", "claude rc", claude("busy"), resume="claude rc"),
        row("api", p("api"), "running", "claude rc", claude("idle"), resume="claude rc"),
        row("notes", p("notes"), "running", "claude rc", claude(None, trust)),
        row("site", p("site"), "running", "npm run dev"),
        row("docs", p("docs"), "stopped", "claude rc", resume="claude rc"),
        row("scratch", home, "running", None, managed=False, autostart=False, named=False),
    ],
    "apps": [{"id": "claude", "name": "Claude", "enabled": True, "builtin": True, "launch": "claude rc",
              "icon": "com.anthropic.claudefordesktop", "match": {"names": ["claude"], "paths": []}}],
    "recipes": [{"id": "clone", "name": "Clone a Git repository", "setup": "git clone {input} .", "input": "Repository URL", "builtin": True}],
    "accounts": {"watched": [{"user": "sam", "name": "Sam Rivera", "logged_in": True, "tend_running": True,
                              "ok": True, "problem": None}], "available": []},
    "dropped": [],
    "folders": {"recent": [], "nearby": [], "parents": []},
    "config": {"config": f"{home}/.config/tend/sessions.json", "state": f"{home}/.config/tend/state.json"},
    "terminal": {"app": "iTerm", "attach": "{tmux} attach -t {target}", "mode": "tmux", "apps": ["iTerm", "Terminal"],
                 "presets": {"tmux": "{tmux} attach -t {target}", "control": "{tmux} -CC attach -t {target}"}},
}
cmd = sys.argv[1] if len(sys.argv) > 1 else ""
if cmd in out:
    json.dump(out[cmd], sys.stdout)

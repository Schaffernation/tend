#!/usr/bin/env python3
"""tend: keep a list of long-running tmux sessions, and restore them.

Each service is a tmux session with a name, a directory, and a command. tend
starts a login shell in the session and types the command into it, so the
shell loads your usual environment and stays open if the command exits.

tend recognizes programs from a list of apps. For each tmux session, it
walks the process tree under the pane's shell and looks for a process that
matches an app, by executable name or path. Claude Code is built in: when a
service runs Claude, tend records the Claude session ID, so a restore
reattaches to the same conversation instead of starting a new one. You can
add your own apps with `tend apps add`.

Usage:
  tend ls [--json]                 List services and unmanaged tmux sessions.
  tend folders [--json]            Suggest folders for a new session: recent
                                   ones, the ones next to them, and their
                                   parent folders.
  tend new [APP] [--dir D] [--mkdir] [--name N] [--no-autostart]
           [--setup CMD | --recipe ID [--input TEXT]] [-- COMMAND...]
                                   Track and start a new session. Runs the
                                   app's launch command (like `claude rc`), or
                                   COMMAND. Picks a free name from the folder.
                                   --setup runs CMD in the folder once first,
                                   like `git clone URL .`; --recipe runs a
                                   saved setup, with TEXT for its {input}.
  tend recipes [--json]            List saved setups for `tend new --recipe`.
  tend recipes add ID --setup CMD [--name NAME] [--input LABEL]
                                   Save a setup. {input} in CMD is replaced
                                   with the --input you give `tend new`.
  tend recipes rm ID               Remove a setup you saved.
  tend answer NAME ANSWER          Answer the question a session is waiting
                                   on, like Claude's trust prompt (yes or no).
  tend wait NAME [--timeout S]     Wait until a session is ready (for Claude,
                                   connected), is waiting on a question, or
                                   has exited. Exit status: 0 ready, 1 exited,
                                   2 question, 3 timed out.
  tend add [NAME] [--dir D] [--no-autostart] [--start] [-- COMMAND...]
                                   Track a service. With no command, tend
                                   copies the command from a running session.
  tend snapshot [NAME...]          Track running tmux sessions (default: all).
  tend rm NAME [--stop]            Stop tracking a service.
  tend start NAME [--fresh]        Start a service. Resumes Claude unless --fresh.
  tend stop NAME                   Kill the service's tmux session.
  tend restart NAME [--fresh]      Stop, then start. Works from inside the
                                   session it restarts.
  tend history NAME [--json]       List the conversations a service has run
                                   (Claude Remote Control), newest first.
  tend resume NAME [ID]            Bring back a past conversation, the latest
                                   by default, after Remote Control has
                                   forgotten it. It runs in single-session
                                   mode; a later restart returns to server
                                   mode and keeps it.
  tend restore [--once]            Start every autostart service that isn't running.
                                   With --once, do nothing if tend already
                                   restored since the Mac started.
  tend autostart NAME on|off       Turn restore-at-login on or off.
  tend accounts [add|rm USER] [--json]
                                   Watch other accounts on this Mac, and
                                   warn when one isn't logged in or isn't
                                   running Tend.
  tend apps [--json]               List the apps tend recognizes (Claude is built in).
  tend apps add PROGRAM [--id ID] [--name NAME] [--icon ICON]
                                   Recognize another program, by name or path.
                                   ICON is a bundle ID or a .app or image
                                   path, for the menu bar app to show.
  tend apps enable|disable ID      Turn recognition of an app on or off.
  tend apps rm ID                  Remove an app you added.
  tend attach NAME                 Attach to the session in this terminal.
  tend open NAME                   Open the session in a new terminal window.
  tend terminal [--app APP] [--attach PRESET|COMMAND] [--json]
                                   Show or change the terminal app and the
                                   command `tend open` runs. The "control"
                                   preset runs tmux -CC for iTerm2's tmux
                                   integration.

For a command's flags, run `tend COMMAND --help`.

Config: ~/.config/tend/services.json (override with TEND_CONFIG).

Source: https://github.com/Schaffernation/tend
"""

import argparse
import ctypes
import fnmatch
import glob
import json
import os
import pwd
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
# ssh commands and GUI apps don't read .zshrc, so set PATH here.
os.environ["PATH"] = (
    f"{HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
)
CONFIG = Path(os.environ.get("TEND_CONFIG", HOME / ".config/tend/services.json"))
SHELLS = {"zsh", "bash", "sh", "fish", "login"}
TERMINALS = ["iTerm", "Terminal"]
# Named attach commands for `tend terminal --attach`. "control" uses tmux
# control mode, which iTerm2 turns into native windows and tabs.
ATTACH_PRESETS = {
    "tmux": "{tmux} attach -t {target}",
    "control": "{tmux} -CC attach -t {target}",
}


class TendError(Exception):
    pass


# ---------------------------------------------------------------- config


def default_config():
    return {
        # Terminal app for `tend open`: "iTerm" or "Terminal".
        "terminal": "iTerm" if Path("/Applications/iTerm.app").exists() else "Terminal",
        # Command that `tend open` runs in the new terminal window. {tmux} is
        # the path to tmux, {target} is the quoted tmux target (=name), and
        # {name} is the quoted session name. See ATTACH_PRESETS.
        "attach_command": ATTACH_PRESETS["tmux"],
        # Launch agent that owns the tmux server, like "com.example.tmux-server".
        # If the server isn't running, tend kickstarts this agent before it
        # starts a session. With null, tend lets tmux start the server itself.
        "tmux_launch_agent": None,
        "services": [],
    }


def load():
    if not CONFIG.exists():
        return default_config()
    cfg = json.loads(CONFIG.read_text())
    for k, v in default_config().items():
        cfg.setdefault(k, v)
    return cfg


def save(cfg):
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG.with_suffix(".tmp")
    tmp.write_text(json.dumps(cfg, indent=2) + "\n")
    tmp.replace(CONFIG)


# State that tend keeps for itself, next to the config.
STATE = CONFIG.with_name("state.json")


def boot_time():
    """When this Mac last started, in seconds since the epoch, or None."""
    r = subprocess.run(["sysctl", "-n", "kern.boottime"], capture_output=True, text=True)
    m = re.search(r"sec = (\d+)", r.stdout)
    return int(m.group(1)) if m else None


def load_state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(state):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n")
    tmp.replace(STATE)


def restored_this_boot():
    boot = boot_time()
    return boot is not None and load_state().get("restored_boot") == boot


def mark_restored():
    state = load_state()
    state["restored_boot"] = boot_time()
    save_state(state)


HISTORY_LIMIT = 20
# How often tend refreshes a conversation's last_seen time, in seconds.
HISTORY_REFRESH = 600


def record_history(seen):
    """Remember the conversations running in each service: {name: [conv]}.

    Each service keeps its last HISTORY_LIMIT conversations, newest first,
    with when tend first and last saw them.
    """
    if not seen:
        return
    state = load_state()
    history = state.setdefault("history", {})
    now = int(time.time())
    changed = False
    for name, convs in seen.items():
        entries = history.setdefault(name, [])
        for c in convs:
            e = next((e for e in entries if e["id"] == c["id"]), None)
            if e is None:
                entries.append({"id": c["id"], "label": c["label"], "first_seen": now, "last_seen": now})
                changed = True
            elif now - e["last_seen"] >= HISTORY_REFRESH or e.get("label") != c["label"]:
                e.update(label=c["label"], last_seen=now)
                changed = True
        entries.sort(key=lambda e: -e["last_seen"])
        del entries[HISTORY_LIMIT:]
    if changed:
        save_state(state)


def find(cfg, name):
    for s in cfg["services"]:
        if s["name"] == name:
            return s
    return None


def need(cfg, name):
    s = find(cfg, name)
    if not s:
        raise TendError(f"no service named '{name}'. Run `tend ls` to see them.")
    return s


def session_name(text):
    # tmux session names can't contain . or :
    return re.sub(r"[.:]", "-", text)


# ---------------------------------------------------------------- tmux


def tmux(*args, check=True):
    if not shutil.which("tmux"):
        raise TendError("tmux isn't installed. Install it with: brew install tmux")
    r = subprocess.run(["tmux", *args], capture_output=True, text=True)
    if check and r.returncode:
        raise TendError(r.stderr.strip() or f"tmux {args[0]} failed")
    return r


def ensure_server(cfg):
    """Make sure the tmux server runs in the launch agent, if one is set."""
    if tmux("info", check=False).returncode == 0:
        return
    agent = cfg.get("tmux_launch_agent")
    if not agent:
        return
    target = f"gui/{os.getuid()}/{agent}"
    subprocess.run(["launchctl", "kickstart", target], capture_output=True)
    for _ in range(30):
        if tmux("info", check=False).returncode == 0:
            return
        time.sleep(0.1)
    raise TendError(
        f"the tmux server isn't running, and the {agent} launch agent didn't start it. "
        f"Check it with: launchctl print {target}"
    )


def has_session(name):
    return tmux("has-session", "-t", f"={name}", check=False).returncode == 0


def tmux_panes():
    """Return {session: [pane, ...]}, with the first pane first."""
    fmt = "\t".join(
        [
            "#{session_name}",
            "#{window_index}",
            "#{pane_index}",
            "#{pane_pid}",
            "#{pane_current_command}",
            "#{pane_current_path}",
            "#{session_attached}",
            "#{session_created}",
        ]
    )
    r = tmux("list-panes", "-a", "-F", fmt, check=False)
    if r.returncode:
        return {}
    sessions = {}
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 8:
            continue
        sess, win, pane, pid, cmd, path, attached, created = parts
        sessions.setdefault(sess, []).append(
            {
                "window": int(win),
                "pane": int(pane),
                "pid": int(pid),
                "cmd": cmd,
                "path": path,
                "attached": attached != "0",
                "created": int(created),
            }
        )
    for panes in sessions.values():
        panes.sort(key=lambda p: (p["window"], p["pane"]))
    return sessions


# ---------------------------------------------------------------- processes


def process_table():
    r = subprocess.run(
        ["ps", "-ax", "-o", "pid=,ppid=,command="], capture_output=True, text=True
    )
    procs, children = {}, {}
    for line in r.stdout.splitlines():
        parts = line.split(None, 2)
        if len(parts) < 2:
            continue
        pid, ppid = int(parts[0]), int(parts[1])
        procs[pid] = {"pid": pid, "ppid": ppid, "command": parts[2] if len(parts) > 2 else ""}
        children.setdefault(ppid, []).append(pid)
    for kids in children.values():
        kids.sort()
    return procs, children


def argv(command):
    try:
        return shlex.split(command)
    except ValueError:
        return command.split()


def descendants(pid, children):
    out, queue = [], list(children.get(pid, []))
    while queue:
        p = queue.pop(0)
        out.append(p)
        queue.extend(children.get(p, []))
    return out


try:
    _libproc = ctypes.CDLL("/usr/lib/libproc.dylib")
except OSError:
    _libproc = None


def exe_path(pid, _cache={}):
    """Return the real path of a process's executable, like /bin/zsh."""
    if pid not in _cache:
        path = ""
        if _libproc:
            buf = ctypes.create_string_buffer(4096)
            if _libproc.proc_pidpath(pid, buf, 4096) > 0:
                path = buf.value.decode(errors="replace")
        _cache[pid] = path
    return _cache[pid]


# ---------------------------------------------------------------- apps
#
# An app tells tend how to recognize a program in a tmux session, and,
# optionally, how to read its state and resume it. Fields:
#
#   id, name     Short ID and display name.
#   icon         Optional. The picture the app shows for it: a bundle ID
#                like "io.tailscale.ipn.macos", or the path to a .app or an
#                image file.
#   match        How to recognize the process. It matches if any rule does:
#     names        Executable names, compared with argv[0] and the real
#                  executable's file name.
#     paths        Glob patterns, compared with the real executable path.
#                For a script run by an interpreter (like `sh script`),
#                both rules also compare the script's name and real path.
#   modes        Optional. The first mode whose `args` contains argv[1]
#                wins; a mode without `args` matches anything. A mode can set
#                `resume`, a command template filled in from the metadata,
#                plus {command}: the running command without strip_flags.
#   strip_flags  Optional. Flags to drop from the saved command, mapped to
#                how many values follow them, so a fresh start stays fresh.
#   launch       Optional. The command `tend new` runs to start a new
#                instance, like `claude rc`.
#   reattach     Optional. The command `tend resume` runs to bring back a
#                past conversation, with {id} from metadata `id_field`.
#   release_wait Optional. After tend stops a process started with one of
#                `args`, it waits `seconds` before starting the app again in
#                that folder, so the old one can let go of it.
#   preflight    Optional. A check tend runs before it starts the app in a
#                folder. The only check so far is "claude-trust".
#   questions    Optional. Prompts the app can stop and wait on. tend looks
#                at the last line of the pane, and the menu bar app offers
#                the answers as buttons. Each has:
#     id           Short ID.
#     match        A regular expression for the last non-empty line. Named
#                  groups fill in {name} in `text`.
#     text         The question to show.
#     answers      [{id, label, keys}]: `tend answer NAME ID` types keys,
#                  then Enter.
#   metadata     Optional. JSON files the program writes about itself:
#     glob         Files to read.
#     pid_field    Field with the PID of a process in the session. tend
#                  matches a file to a session by this PID.
#     status_field, label_field   Fields to show in the app.
#     id_field     Field with a conversation ID. tend keeps a history of
#                  these per service, for `tend history` and `tend resume`.
#     order_field  If several files match a session, the lowest value wins.
#
# Only the topmost matching process counts, so a program that starts copies
# of itself shows up once.

BUILTIN_APPS = [
    {
        "id": "claude",
        "name": "Claude",
        "icon": "com.anthropic.claudefordesktop",
        "match": {"names": ["claude"], "paths": ["*/claude/versions/*"]},
        "modes": [
            {
                "id": "remote-control",
                "args": ["rc", "remote-control"],
                # Restart the same command. Remote Control keeps its
                # environment, so a plain restart reconnects the last
                # conversation and stays in server mode, where the app can
                # start new sessions. --session-id and --continue reconnect
                # in single-session mode, which turns that off.
                "resume": "{command}",
            },
            {"id": "interactive", "resume": "claude --resume {sessionId}"},
        ],
        "launch": "claude rc",
        # Brings a conversation back after Remote Control has forgotten it,
        # in single-session mode. A later plain restart returns to server
        # mode and keeps the conversation.
        "reattach": "claude remote-control --session-id {id}",
        "release_wait": {"args": ["--session-id", "-c", "--continue"], "seconds": 45},
        "preflight": "claude-trust",
        "questions": [
            {
                # claude rc asks this in a folder you haven't trusted.
                "id": "trust",
                "match": r"^Trust (?P<folder>.+)\? \[y/N\]\s*$",
                "text": "Trust {folder} in Claude Code? Sessions there can read, edit, and run files.",
                "answers": [
                    {"id": "yes", "label": "Trust", "keys": "y"},
                    {"id": "no", "label": "Don't trust", "keys": "n"},
                ],
            }
        ],
        "strip_flags": {"-c": 0, "--continue": 0, "--session-id": 1, "-r": 1, "--resume": 1},
        "metadata": {
            "glob": "~/.claude/sessions/*.json",
            "pid_field": "pid",
            "status_field": "status",
            "label_field": "name",
            "id_field": "bridgeSessionId",
            "order_field": "startedAt",
        },
    }
]


def apps(cfg):
    """Built-in apps with your changes applied, then your own apps."""
    custom = {a["id"]: a for a in cfg.get("apps", [])}
    out = []
    for b in BUILTIN_APPS:
        out.append({**b, **custom.pop(b["id"], {}), "builtin": True})
    out.extend({**a, "builtin": False} for a in custom.values())
    for a in out:
        a.setdefault("enabled", True)
    return out


# Programs that run a script named by their first argument, like
# `sh ~/.local/bin/tailscale-keepalive`.
INTERPRETERS = {"zsh", "bash", "sh", "fish", "python", "python3", "node", "ruby", "perl"}


def script_path(a):
    """For `INTERPRETER SCRIPT ...`, return the script's real path."""
    if len(a) < 2 or os.path.basename(a[0]).lstrip("-") not in INTERPRETERS:
        return ""
    if a[1].startswith("-") or not os.path.isfile(a[1]):
        return ""
    return os.path.realpath(a[1])


def matches(app, proc):
    a = argv(proc["command"])
    m = app.get("match", {})
    exe = exe_path(proc["pid"])
    names = set(m.get("names", []))
    paths = m.get("paths", [])
    if a and os.path.basename(a[0]).lstrip("-") in names:
        return True
    for path in (exe, script_path(a)):
        if path and (os.path.basename(path) in names or any(fnmatch.fnmatch(path, g) for g in paths)):
            return True
    return False


def read_metadata(app):
    md = app.get("metadata")
    if not md:
        return []
    out = []
    for f in glob.glob(os.path.expanduser(md["glob"])):
        try:
            d = json.loads(Path(f).read_text())
            d["_pid"] = int(d[md.get("pid_field", "pid")])
        except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
            continue
        out.append(d)
    return out


def describe(app, proc, pids, metadata):
    """What tend knows about one running app."""
    a = argv(proc["command"])
    mode = next(
        (
            m
            for m in app.get("modes", [])
            if "args" not in m or (len(a) > 1 and a[1] in m["args"])
        ),
        {},
    )
    md = app.get("metadata") or {}
    meta = sorted(
        (d for d in metadata if d["_pid"] in pids),
        key=lambda d: d.get(md.get("order_field", "_pid"), 0),
    )
    m = meta[0] if meta else {}

    # Drop resume flags, so the saved command always starts fresh.
    strip = app.get("strip_flags", {})
    base, skip = a[:1], 0
    for arg in a[1:]:
        if skip:
            skip -= 1
        elif arg in strip:
            skip = strip[arg]
        elif not any(arg.startswith(f + "=") for f in strip if f.startswith("--")):
            base.append(arg)

    resume = None
    if mode.get("resume") and m:
        try:
            resume = mode["resume"].format_map({**m, "command": shlex.join(base)})
        except (KeyError, IndexError, ValueError):
            pass
    return {
        "id": app["id"],
        "name": app.get("name", app["id"]),
        "icon": app.get("icon"),
        "mode": mode.get("id"),
        "command": shlex.join(base),
        "status": m.get(md.get("status_field", ""), None),
        "label": m.get(md.get("label_field", ""), None),
        "resume": resume,
        "instances": len(meta),
        "pid": proc["pid"],
        "args": a,
        "conversations": [
            {"id": d[md["id_field"]], "label": d.get(md.get("label_field", ""))}
            for d in meta
            if md.get("id_field") and d.get(md["id_field"])
        ],
    }


def inspect_session(name, panes, procs, children, app_list, metadata):
    """Work out what runs in a tmux session."""
    main = panes[0]
    kids = children.get(main["pid"], [])
    foreground = procs[kids[0]]["command"] if kids else None

    found = None
    for pane in panes:
        pids = descendants(pane["pid"], children)
        for pid in pids:
            p = procs.get(pid)
            if not p:
                continue
            for app in app_list:
                # Skip a process whose parent is the same app: the topmost
                # one is the command you typed.
                parent = procs.get(p["ppid"])
                if matches(app, p) and not (parent and matches(app, parent)):
                    found = describe(app, p, set(pids), metadata.get(app["id"], []))
                    found["pane"] = f"={name}:{pane['window']}.{pane['pane']}"
                    found["question"] = pending_question(app, found["pane"])
                    break
            if found:
                break
        if found:
            break

    return {
        "state": "running" if found or foreground else "exited",
        "foreground": foreground,
        "path": main["path"],
        "attached": any(p["attached"] for p in panes),
        "app": found,
    }


def pending_question(app, target):
    """Return the question the app is waiting on in a pane, or None."""
    questions = app.get("questions")
    if not questions:
        return None
    r = tmux("capture-pane", "-p", "-t", target, check=False)
    lines = [l for l in r.stdout.splitlines() if l.strip()] if r.returncode == 0 else []
    if not lines:
        return None
    for q in questions:
        m = re.search(q["match"], lines[-1])
        if m:
            return {
                "id": q["id"],
                "text": q["text"].format_map({k: v or "" for k, v in m.groupdict().items()}),
                "answers": [{"id": x["id"], "label": x["label"]} for x in q["answers"]],
            }
    return None


def detected_command(info):
    if info["app"]:
        return info["app"]["command"]
    fg = info["foreground"]
    if fg and os.path.basename(argv(fg)[0]).lstrip("-") not in SHELLS:
        return fg
    return None


# ---------------------------------------------------------------- status


def status(cfg, sync=True):
    """Return a row per service and per unmanaged tmux session.

    With sync, tend records the resume command of each running service (for
    Claude, the session ID), so a later restore reattaches to the latest
    conversation.
    """
    panes = tmux_panes()
    procs, children = process_table()
    app_list = [a for a in apps(cfg) if a["enabled"]]
    metadata = {a["id"]: read_metadata(a) for a in app_list}
    rows, changed, conversations = [], False, {}

    seen = set()
    for s in cfg["services"]:
        seen.add(s["name"])
        row = {
            "name": s["name"],
            "dir": s["dir"],
            "command": s.get("command"),
            "resume": s.get("resume"),
            "autostart": s.get("autostart", True),
            "managed": True,
            "state": "stopped",
            "attached": False,
            "app": None,
        }
        if s["name"] in panes:
            info = inspect_session(s["name"], panes[s["name"]], procs, children, app_list, metadata)
            row.update(state=info["state"], attached=info["attached"], app=info["app"])
            if sync and info["app"] and info["app"]["conversations"]:
                conversations[s["name"]] = info["app"]["conversations"]
            resume = info["app"] and info["app"]["resume"]
            if sync and resume and resume != s.get("resume"):
                s["resume"] = row["resume"] = resume
                changed = True
        rows.append(row)

    for name, sp in sorted(panes.items()):
        if name in seen:
            continue
        info = inspect_session(name, sp, procs, children, app_list, metadata)
        rows.append(
            {
                "name": name,
                "dir": info["path"],
                "command": detected_command(info),
                "resume": info["app"] and info["app"]["resume"],
                "autostart": False,
                "managed": False,
                "state": info["state"],
                "attached": info["attached"],
                "app": info["app"],
            }
        )

    if changed:
        save(cfg)
    record_history(conversations)
    return rows


# ---------------------------------------------------------------- actions


def preflight(check, d, name):
    """Return a note about starting an app in folder d, or None."""
    if check == "claude-trust":
        # claude rc asks whether to trust a new folder, and waits. In tmux
        # nobody sees the question, so say where to answer it. Trusting a
        # parent folder counts too.
        try:
            projects = json.loads((HOME / ".claude.json").read_text()).get("projects", {})
        except (OSError, json.JSONDecodeError):
            return None
        p = d
        while True:
            if projects.get(p, {}).get("hasTrustDialogAccepted"):
                return None
            if p == "/":
                break
            p = os.path.dirname(p)
        return (
            f"Claude will ask whether to trust {d}. Answer in the Tend menu, "
            f"or run `tend answer {name} yes`."
        )
    return None


def run_setup(cmd, d):
    """Run a setup command in folder d with your login shell's environment."""
    print(f"Running setup: {cmd}", flush=True)
    shell = os.environ.get("SHELL") or "/bin/zsh"
    try:
        r = subprocess.run([shell, "-lc", cmd], cwd=d, capture_output=True, text=True, timeout=900)
    except subprocess.TimeoutExpired:
        raise TendError(f"setup didn't finish in 15 minutes: {cmd}")
    if r.returncode:
        out = (r.stderr.strip() or r.stdout.strip()).splitlines()[-5:]
        raise TendError(f"setup failed (exit {r.returncode}): {cmd}\n" + "\n".join(out))


# Saved setups for `tend new --recipe`. Entries in the config's `recipes`
# list override these by `id`, or add new ones.
BUILTIN_RECIPES = [
    {
        "id": "clone",
        "name": "Clone a Git repository",
        "setup": "git clone {input} .",
        "input": "Repository URL",
    }
]


def recipes(cfg):
    custom = {r["id"]: r for r in cfg.get("recipes", [])}
    out = [{**b, **custom.pop(b["id"], {}), "builtin": True} for b in BUILTIN_RECIPES]
    out.extend({**r, "builtin": False} for r in custom.values())
    return out


def recipe_command(cfg, rid, text):
    r = next((x for x in recipes(cfg) if x["id"] == rid), None)
    if not r:
        raise TendError(f"no recipe with ID '{rid}'. Run `tend recipes` to see them.")
    if "{input}" in r["setup"]:
        if not text:
            raise TendError(f"recipe '{rid}' needs --input ({r.get('input', 'text')}).")
        return r["setup"].replace("{input}", shlex.quote(text))
    return r["setup"]


def recipes_command(cfg, a):
    custom = cfg.setdefault("recipes", [])
    by_id = {x["id"]: x for x in recipes(cfg)}
    if a.action == "ls":
        if a.json:
            json.dump(list(by_id.values()), sys.stdout, indent=2)
            print()
            return
        for x in by_id.values():
            print(f"{x['id']:<12} {x.get('name', x['id'])}{' (built in)' if x['builtin'] else ''}: {x['setup']}")
        return
    if not a.target:
        raise TendError(f"`tend recipes {a.action}` needs a recipe ID.")
    if a.action == "add":
        if not a.setup:
            raise TendError("`tend recipes add` needs --setup.")
        if a.target in by_id and by_id[a.target]["builtin"]:
            raise TendError(f"'{a.target}' is built in. Pick another ID.")
        entry = {"id": a.target, "name": a.name or a.target, "setup": a.setup}
        if a.input:
            entry["input"] = a.input
        cfg["recipes"] = [x for x in custom if x["id"] != a.target] + [entry]
        save(cfg)
        print(f"Saved recipe '{a.target}'.")
        return
    if a.target not in by_id or by_id[a.target]["builtin"]:
        raise TendError(f"no saved recipe with ID '{a.target}'.")
    cfg["recipes"] = [x for x in custom if x["id"] != a.target]
    save(cfg)
    print(f"Removed recipe '{a.target}'.")


def wait(cfg, name, timeout):
    """Wait for a session to settle. Return (exit status, message)."""
    began = time.monotonic()
    deadline = began + timeout
    seen_running = False
    while True:
        row = next((r for r in status(cfg, sync=False) if r["name"] == name), None)
        if not row:
            raise TendError(f"no session named '{name}'.")
        c = row["app"]
        seen_running = seen_running or row["state"] == "running"
        # Right after a start, the shell may not have run the command yet.
        if row["state"] == "exited" and not seen_running and time.monotonic() - began < 10:
            time.sleep(1)
            continue
        if row["state"] != "running":
            return 1, f"'{name}' isn't running: its command {'exited' if row['state'] == 'exited' else 'stopped'}."
        if c and c.get("question"):
            q = c["question"]
            ids = "|".join(x["id"] for x in q["answers"])
            return 2, f"'{name}' is waiting: {q['text']}\nAnswer with `tend answer {name} {ids}`."
        app = c and next((x for x in apps(cfg) if x["id"] == c["id"]), None)
        # An app that reports a status is ready once it does; any other
        # running command is ready now.
        if not (app and app.get("metadata", {}).get("status_field")) or c["status"]:
            what = f"{c['name']} is {c['status']}" if c and c["status"] else "it's running"
            return 0, f"'{name}' is ready: {what}."
        if time.monotonic() >= deadline:
            return 3, f"'{name}' is still starting after {timeout} seconds. Check it with `tend open {name}`."
        time.sleep(2)


def answer(cfg, name, answer_id):
    """Type the answer to the question a session is waiting on."""
    row = next((r for r in status(cfg, sync=False) if r["name"] == name), None)
    if not row:
        raise TendError(f"no session named '{name}'.")
    q = row["app"] and row["app"].get("question")
    if not q:
        raise TendError(f"'{name}' isn't waiting on a question.")
    app = next(x for x in apps(cfg) if x["id"] == row["app"]["id"])
    spec = next(x for x in app["questions"] if x["id"] == q["id"])
    choice = next((x for x in spec["answers"] if x["id"] == answer_id), None)
    if not choice:
        ids = " or ".join(x["id"] for x in spec["answers"])
        raise TendError(f"answer with {ids}.")
    tmux("send-keys", "-t", row["app"]["pane"], "-l", "--", choice["keys"])
    tmux("send-keys", "-t", row["app"]["pane"], "Enter")
    return f"Answered '{choice['label']}' in '{name}'."


def unique_name(cfg, name):
    candidate, n = name, 2
    while find(cfg, candidate) or has_session(candidate):
        candidate, n = f"{name}-{n}", n + 1
    return candidate


def start(cfg, s, fresh=False, command=None):
    if has_session(s["name"]):
        return f"'{s['name']}' is already running."
    if not Path(s["dir"]).is_dir():
        raise TendError(f"{s['dir']} isn't a directory.")
    ensure_server(cfg)
    cmd = command or (s.get("command") if fresh else (s.get("resume") or s.get("command")))
    tmux("new-session", "-d", "-s", s["name"], "-c", s["dir"])
    if cmd:
        tmux("send-keys", "-t", f"={s['name']}:", "-l", "--", cmd)
        tmux("send-keys", "-t", f"={s['name']}:", "Enter")
    return f"Started '{s['name']}'" + (f": {cmd}" if cmd else " (shell only).")


def stop(s_name):
    if not has_session(s_name):
        return f"'{s_name}' isn't running."
    tmux("kill-session", "-t", f"={s_name}")
    return f"Stopped '{s_name}'."


def open_in_terminal(cfg, name):
    if not has_session(name):
        raise TendError(f"'{name}' isn't running.")
    attach = (
        cfg.get("attach_command", ATTACH_PRESETS["tmux"])
        .replace("{tmux}", shlex.quote(shutil.which("tmux")))
        .replace("{target}", shlex.quote(f"={name}"))
        .replace("{name}", shlex.quote(name))
    )
    if cfg.get("terminal", "").lower().startswith("iterm"):
        script = (
            'tell application "iTerm"\n'
            "  activate\n"
            f"  create window with default profile command {json.dumps(attach)}\n"
            "end tell"
        )
    else:
        script = (
            'tell application "Terminal"\n'
            "  activate\n"
            f"  do script {json.dumps(attach)}\n"
            "end tell"
        )
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if r.returncode:
        raise TendError(r.stderr.strip())


def current_session():
    """The tmux session this process runs in, or None.

    A command handed off to the tmux server runs with TMUX set too, so
    hand_off marks it with TEND_HANDED_OFF.
    """
    if not os.environ.get("TMUX") or os.environ.get("TEND_HANDED_OFF"):
        return None
    r = tmux("display-message", "-p", "#S", check=False)
    return r.stdout.strip() or None


def hand_off(argv_tail):
    """Run this tend command from the tmux server instead of this process.

    Stopping the session tend runs in would end tend before it could start
    the session again. The tmux server keeps running.
    """
    cmd = "TEND_HANDED_OFF=1 " + shlex.join([os.path.realpath(sys.argv[0]), *argv_tail])
    if "TEND_CONFIG" in os.environ:
        cmd = f"TEND_CONFIG={shlex.quote(os.environ['TEND_CONFIG'])} {cmd}"
    tmux("run-shell", "-b", cmd)


def stop_for_restart(cfg, name):
    """Stop a session, then wait if its app needs time to let go of the folder."""
    row = next((r for r in status(cfg) if r["name"] == name), None)
    out = stop(name)
    info = row and row["app"]
    if info:
        app = next((x for x in apps(cfg) if x["id"] == info["id"]), {})
        wait = app.get("release_wait")
        if wait and any(arg in wait["args"] for arg in info.get("args", [])):
            print(out)
            print(f"Waiting {wait['seconds']} seconds for {info['name']} to let go of the folder…")
            sys.stdout.flush()
            time.sleep(wait["seconds"])
            return None
    return out


def history_for(name):
    return load_state().get("history", {}).get(name, [])


def ago(t):
    d = int(time.time()) - t
    for unit, n in (("day", 86400), ("hour", 3600), ("minute", 60)):
        if d >= n:
            return f"{d // n} {unit}{'s' if d // n != 1 else ''} ago"
    return "just now"


def terminal_settings(cfg):
    attach = cfg.get("attach_command", ATTACH_PRESETS["tmux"])
    mode = next((k for k, v in ATTACH_PRESETS.items() if v == attach), "custom")
    return {
        "app": cfg.get("terminal"),
        "attach": attach,
        "mode": mode,
        "apps": TERMINALS,
        "presets": ATTACH_PRESETS,
    }


def set_terminal(cfg, app=None, attach=None):
    if app is not None:
        match = next((t for t in TERMINALS if t.lower() == app.lower()), None)
        if not match:
            raise TendError(f"tend can open {' or '.join(TERMINALS)}, not '{app}'.")
        cfg["terminal"] = match
    if attach is not None:
        attach = ATTACH_PRESETS.get(attach, attach).strip()
        if "{target}" not in attach and "{name}" not in attach:
            raise TendError(
                "the attach command needs {target} or {name}, so it knows which session "
                f"to attach to. Or use a preset: {', '.join(ATTACH_PRESETS)}."
            )
        cfg["attach_command"] = attach
    save(cfg)


def adopt(cfg, name, rows=None):
    """Track a running tmux session, copying its directory and command."""
    rows = rows if rows is not None else status(cfg, sync=False)
    row = next((r for r in rows if r["name"] == name), None)
    if not row:
        raise TendError(f"no tmux session named '{name}'.")
    if row["managed"]:
        return None
    s = {"name": name, "dir": row["dir"], "command": row["command"], "autostart": True}
    if row["resume"]:
        s["resume"] = row["resume"]
    cfg["services"].append(s)
    return s


# ---------------------------------------------------------------- CLI


def apps_command(cfg, a):
    custom = cfg.setdefault("apps", [])
    by_id = {x["id"]: x for x in apps(cfg)}

    if a.action == "ls":
        rows = list(by_id.values())
        if a.json:
            json.dump(rows, sys.stdout, indent=2)
            print()
            return
        for x in rows:
            m = x.get("match", {})
            rules = ", ".join(m.get("names", []) + m.get("paths", []))
            flags = ("" if x["enabled"] else " (off)") + (" (built in)" if x["builtin"] else "")
            print(f"{x['id']:<12} {x.get('name', x['id'])}{flags}: {rules}")
        return

    if not a.target:
        raise TendError(f"`tend apps {a.action}` needs an app ID or program.")

    if a.action == "add":
        target = a.target
        path = shutil.which(target) if "/" not in target else os.path.expanduser(target)
        if not path or not os.path.exists(path):
            raise TendError(f"can't find a program named '{target}'.")
        real = os.path.realpath(path)
        app_id = a.id or re.sub(r"[^a-z0-9-]+", "-", Path(target).name.lower()).strip("-")
        if app_id in by_id:
            raise TendError(f"there's already an app with ID '{app_id}'. Pick another with --id.")
        names = sorted({Path(path).name, Path(real).name})
        entry = {
            "id": app_id,
            "name": a.name or Path(path).name,
            "match": {"names": names, "paths": [real]},
        }
        if a.icon:
            entry["icon"] = os.path.expanduser(a.icon) if a.icon.startswith("~") else a.icon
        custom.append(entry)
        save(cfg)
        print(f"Added '{app_id}'. It matches processes named {', '.join(names)}, or running {real}.")
        return

    if a.target not in by_id:
        raise TendError(f"no app with ID '{a.target}'. Run `tend apps` to see them.")

    if a.action == "rm":
        if by_id[a.target]["builtin"]:
            raise TendError(f"'{a.target}' is built in. Turn it off with `tend apps disable {a.target}`.")
        cfg["apps"] = [x for x in custom if x["id"] != a.target]
        save(cfg)
        print(f"Removed '{a.target}'.")
        return

    entry = next((x for x in custom if x["id"] == a.target), None)
    if entry is None:
        entry = {"id": a.target}
        custom.append(entry)
    entry["enabled"] = a.action == "enable"
    save(cfg)
    print(f"'{a.target}' is {'on' if entry['enabled'] else 'off'}.")



# ---------------------------------------------------------------- folders


# Folder extensions that macOS shows as a single file, like a Pages document.
PACKAGES = {
    ".app", ".bundle", ".framework", ".plugin", ".pages", ".numbers", ".key",
    ".rtfd", ".photoslibrary", ".xcodeproj", ".xcworkspace", ".playground",
    ".logicx", ".band", ".fcpbundle", ".imovielibrary", ".dtbase2", ".sparsebundle",
}


def folders(cfg):
    """Folders to suggest for a new session.

    recent: the folders of tracked services and running tmux sessions.
    nearby: the other folders next to them, like your other projects, most
    recently changed first.
    parents: the folders that hold them, most used first, for a new folder.
    """
    recent = sorted({r["dir"] for r in status(cfg, sync=False) if r["dir"]})
    counts = {}
    for d in recent:
        parent = str(Path(d).parent)
        counts[parent] = counts.get(parent, 0) + 1
    parents = sorted(counts, key=lambda p: (-counts[p], p))
    nearby = {}
    for parent in parents:
        try:
            for child in Path(parent).iterdir():
                if (
                    child.is_dir()
                    and not child.name.startswith(".")
                    and child.suffix.lower() not in PACKAGES
                    and str(child) not in recent
                ):
                    nearby[str(child)] = child.stat().st_mtime
        except OSError:
            pass
    return {
        "recent": recent,
        "nearby": sorted(nearby, key=nearby.get, reverse=True),
        "parents": parents,
    }


# ---------------------------------------------------------------- accounts
#
# Other accounts on this Mac that should run their own Tend, like a family member's
# account under fast user switching. tend can't see inside another account,
# but it can see which processes that user runs: a loginwindow process means
# the user is logged in, and a Tend process means their Tend is running.


def local_users():
    """People's accounts on this Mac, except the current one: {user: full name}."""
    r = subprocess.run(["dscl", ".", "list", "/Users", "UniqueID"], capture_output=True, text=True)
    me = pwd.getpwuid(os.getuid()).pw_name
    users = {}
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1].isdigit() and int(parts[1]) >= 500:
            user = parts[0]
            if user != me and not user.startswith("_"):
                users[user] = full_name(user)
    return users


def full_name(user):
    try:
        return pwd.getpwnam(user).pw_gecos or user
    except KeyError:
        return user


def runs(user, process):
    r = subprocess.run(["pgrep", "-x", "-u", user, process], capture_output=True)
    return r.returncode == 0


def account_status(user):
    logged_in = runs(user, "loginwindow")
    tend_running = logged_in and runs(user, "Tend")
    st = {
        "user": user,
        "name": full_name(user),
        "logged_in": logged_in,
        "tend_running": tend_running,
        "ok": tend_running,
    }
    st["problem"] = account_problem(st)
    return st


def account_problem(a):
    if not a["logged_in"]:
        return f"{a['name']} isn't logged in, so their sessions aren't running."
    if not a["tend_running"]:
        return f"Tend isn't running for {a['name']}, so their sessions won't restart."
    return None


def accounts_command(cfg, a):
    watched = cfg.setdefault("accounts", [])
    if a.action == "add":
        if not a.user:
            raise TendError("give a user name. Run `tend accounts` to see them.")
        users = local_users()
        if a.user not in users:
            raise TendError(
                f"no other account named '{a.user}'. Accounts: {', '.join(users) or 'none'}."
            )
        if a.user not in watched:
            watched.append(a.user)
            save(cfg)
        print(f"Watching {users[a.user]}'s account.")
        return
    if a.action == "rm":
        if a.user not in watched:
            raise TendError(f"'{a.user}' isn't on the list.")
        watched.remove(a.user)
        save(cfg)
        print(f"Stopped watching {full_name(a.user)}'s account.")
        return

    statuses = [account_status(u) for u in watched]
    if a.json:
        available = [{"user": u, "name": n} for u, n in local_users().items() if u not in watched]
        json.dump({"watched": statuses, "available": available}, sys.stdout, indent=2)
        print()
        return
    if not statuses:
        print("No accounts watched. Add one with `tend accounts add USER`.")
    for st in statuses:
        print(f"{st['user']}: {st['problem'] or 'Tend is running.'}")


def print_account_problems(cfg):
    for user in cfg.get("accounts", []):
        problem = account_status(user)["problem"]
        if problem:
            print(f"Warning: {problem}")


def print_table(rows):
    if not rows:
        print("No services and no tmux sessions. Track one with `tend add`.")
        return
    home = str(HOME)
    table = [("NAME", "STATE", "APP", "AUTO", "DIR", "COMMAND")]
    for r in rows:
        c = r["app"]
        table.append(
            (
                r["name"] + ("" if r["managed"] else " *"),
                r["state"] + (" (attached)" if r["attached"] else ""),
                f"{c['name']} {c['status'] or ''}".strip() if c else "-",
                ("yes" if r["autostart"] else "no") if r["managed"] else "-",
                r["dir"].replace(home, "~", 1),
                r["command"] or "(shell)",
            )
        )
    widths = [max(len(row[i]) for row in table) for i in range(5)]
    for row in table:
        print("  ".join(v.ljust(w) for v, w in zip(row[:5], widths)) + "  " + row[5])
    if any(not r["managed"] for r in rows):
        print("\n* not tracked. Run `tend snapshot` to track every running session.")
    for r in rows:
        q = r["app"] and r["app"].get("question")
        if q:
            ids = "|".join(x["id"] for x in q["answers"])
            print(f"\n{r['name']} is waiting: {q['text']}\n  Answer with `tend answer {r['name']} {ids}`.")


def main():
    p = argparse.ArgumentParser(prog="tend", description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("ls", aliases=["status"])
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("add")
    sp.add_argument("name", nargs="?")
    sp.add_argument("--dir", default=os.getcwd())
    sp.add_argument("--no-autostart", action="store_true")
    sp.add_argument("--start", action="store_true")

    sp = sub.add_parser("new")
    sp.add_argument("app", nargs="?")
    sp.add_argument("--dir", default=os.getcwd())
    sp.add_argument("--name")
    sp.add_argument("--no-autostart", action="store_true")
    sp.add_argument("--command", help="a shell command, typed into the session as is")
    sp.add_argument("--mkdir", action="store_true", help="create the folder if it doesn't exist")
    sp.add_argument("--setup", help="a shell command to run in the folder once, before the app starts")
    sp.add_argument("--recipe", help="a saved setup, from `tend recipes`")
    sp.add_argument("--input", help="the text for the recipe's {input}, like a repository URL")

    sp = sub.add_parser("recipes", help="list or change saved setups for `tend new`")
    sp.add_argument("action", nargs="?", choices=["ls", "add", "rm"], default="ls")
    sp.add_argument("target", nargs="?", help="a recipe ID")
    sp.add_argument("--setup", help="for add: the shell command, with {input} for the text")
    sp.add_argument("--name")
    sp.add_argument("--input", help="for add: a label for the text {input} stands for")
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("wait", help="wait until a session is ready, asks a question, or exits")
    sp.add_argument("name")
    sp.add_argument("--timeout", type=int, default=90, help="seconds to wait (default 90)")

    sp = sub.add_parser("answer", help="answer the question a session is waiting on")
    sp.add_argument("name")
    sp.add_argument("answer")

    sp = sub.add_parser("folders", help="suggest folders for a new session")
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("snapshot")
    sp.add_argument("names", nargs="*")

    sp = sub.add_parser("rm")
    sp.add_argument("name")
    sp.add_argument("--stop", action="store_true")

    for c in ("start", "restart"):
        sp = sub.add_parser(c)
        sp.add_argument("name")
        sp.add_argument("--fresh", action="store_true", help="ignore the saved Claude session")

    for c in ("stop", "attach", "open"):
        sub.add_parser(c).add_argument("name")

    sp = sub.add_parser("history", help="list the conversations a service has run")
    sp.add_argument("name")
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("resume", help="bring back a past conversation in a service")
    sp.add_argument("name")
    sp.add_argument("id", nargs="?", help="a conversation ID from `tend history` (default: the latest)")

    sp = sub.add_parser("restore")
    sp.add_argument(
        "--once",
        action="store_true",
        help="do nothing if tend already restored since the Mac started",
    )

    sp = sub.add_parser("apps", help="list or change the apps tend recognizes")
    sp.add_argument("action", nargs="?", choices=["ls", "add", "rm", "enable", "disable"], default="ls")
    sp.add_argument("target", nargs="?", help="an app ID, or for add, a program name or path")
    sp.add_argument("--id")
    sp.add_argument("--name")
    sp.add_argument("--icon", help="for add: a bundle ID, or a .app or image path")
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("terminal", help="show or change how `tend open` opens a session")
    sp.add_argument("--app", help=f"the terminal app: {' or '.join(TERMINALS)}")
    sp.add_argument(
        "--attach",
        help=f"a preset ({', '.join(ATTACH_PRESETS)}) or a command with {{target}} or {{name}}",
    )
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser(
        "accounts", help="watch other accounts on this Mac, to check that Tend runs there"
    )
    sp.add_argument("action", nargs="?", choices=["ls", "add", "rm"], default="ls")
    sp.add_argument("user", nargs="?", help="the account's short user name")
    sp.add_argument("--json", action="store_true")

    sp = sub.add_parser("autostart")
    sp.add_argument("name")
    sp.add_argument("value", choices=["on", "off"])

    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    command = []
    if "--" in args:
        i = args.index("--")
        args, command = args[:i], args[i + 1 :]
    a = p.parse_args(args)
    cfg = load()

    if a.cmd in ("ls", "status"):
        rows = status(cfg)
        if a.json:
            json.dump(rows, sys.stdout, indent=2)
            print()
        else:
            print_table(rows)
            print_account_problems(cfg)

    elif a.cmd == "new":
        d = str(Path(a.dir).expanduser().resolve())
        if a.setup and a.recipe:
            raise TendError("give --setup or --recipe, not both.")
        setup = a.setup or (a.recipe and recipe_command(cfg, a.recipe, a.input))
        if a.mkdir and not Path(d).exists():
            Path(d).mkdir(parents=True)
            print(f"Created {d}.", flush=True)
        if not Path(d).is_dir():
            raise TendError(f"{d} isn't a directory.")
        app = None
        if a.app:
            app = next((x for x in apps(cfg) if x["id"] == a.app), None)
            if not app:
                raise TendError(f"no app with ID '{a.app}'. Run `tend apps` to see them.")
        cmd = a.command or (shlex.join(command) if command else (app or {}).get("launch"))
        if app and not cmd:
            raise TendError(f"'{app['id']}' has no launch command. Give one after --.")
        name = unique_name(cfg, session_name(a.name or Path(d).name))
        if setup:
            run_setup(setup, d)
        note = app and app.get("preflight") and preflight(app["preflight"], d, name)
        s = {"name": name, "dir": d, "command": cmd, "autostart": not a.no_autostart}
        cfg["services"].append(s)
        save(cfg)
        print(start(cfg, s))
        if note:
            print(note)

    elif a.cmd == "add":
        d = str(Path(a.dir).expanduser().resolve())
        name = session_name(a.name or Path(d).name)
        if find(cfg, name):
            raise TendError(f"'{name}' is already tracked. Remove it first with `tend rm {name}`.")
        if not command and has_session(name):
            adopt(cfg, name)
        else:
            cfg["services"].append(
                {
                    "name": name,
                    "dir": d,
                    "command": shlex.join(command) if command else None,
                    "autostart": not a.no_autostart,
                }
            )
        save(cfg)
        print(f"Tracking '{name}'.")
        if a.start:
            print(start(cfg, need(cfg, name)))

    elif a.cmd == "snapshot":
        rows = status(cfg, sync=False)
        names = a.names or [r["name"] for r in rows if not r["managed"]]
        added = [s for n in names if (s := adopt(cfg, n, rows))]
        save(cfg)
        for s in added:
            print(f"Tracking '{s['name']}': {s.get('resume') or s['command'] or '(shell)'}")
        if not added:
            print("Every running session is already tracked.")

    elif a.cmd == "rm":
        need(cfg, a.name)
        if a.stop:
            print(stop(a.name))
        cfg["services"] = [s for s in cfg["services"] if s["name"] != a.name]
        save(cfg)
        print(f"Stopped tracking '{a.name}'.")

    elif a.cmd == "start":
        print(start(cfg, need(cfg, a.name), a.fresh))

    elif a.cmd == "stop":
        print(stop(a.name))

    elif a.cmd == "restart":
        s = need(cfg, a.name)
        if current_session() == a.name:
            hand_off(["restart", a.name] + (["--fresh"] if a.fresh else []))
            print(f"Restarting '{a.name}', the session this runs in. It closes now and starts again shortly.")
            return
        out = stop_for_restart(cfg, a.name)  # also records the latest conversation
        if out:
            print(out)
        print(start(cfg, s, a.fresh))

    elif a.cmd == "history":
        need(cfg, a.name)
        entries = history_for(a.name)
        if a.json:
            json.dump(entries, sys.stdout, indent=2)
            print()
        elif not entries:
            print(f"No conversations recorded for '{a.name}' yet.")
        else:
            for e in entries:
                print(f"{e['id']}  {ago(e['last_seen']):>16}  {e.get('label') or ''}")

    elif a.cmd == "resume":
        s = need(cfg, a.name)
        app = None
        for row in status(cfg, sync=False):
            if row["name"] == a.name and row["app"]:
                app = next((x for x in apps(cfg) if x["id"] == row["app"]["id"]), None)
        app = app or next((x for x in apps(cfg) if x.get("reattach")), None)
        if not app or not app.get("reattach"):
            raise TendError(f"tend doesn't know how to bring back a conversation in '{a.name}'.")
        entries = history_for(a.name)
        conv = a.id or (entries[0]["id"] if entries else None)
        if not conv:
            raise TendError(f"no conversations recorded for '{a.name}'. Give an ID.")
        if current_session() == a.name:
            hand_off(["resume", a.name, conv])
            print(f"Resuming {conv} in '{a.name}', the session this runs in. It closes now and starts again shortly.")
            return
        if has_session(a.name):
            out = stop_for_restart(cfg, a.name)
            if out:
                print(out)
        print(start(cfg, s, command=app["reattach"].format(id=conv)))

    elif a.cmd == "restore":
        if a.once and restored_this_boot():
            print("Already restored since the Mac started. Nothing to do.")
            return
        mark_restored()
        todo = [s for s in cfg["services"] if s.get("autostart", True) and not has_session(s["name"])]
        for s in todo:
            try:
                print(start(cfg, s))
            except TendError as e:
                print(f"tend: couldn't start '{s['name']}': {e}", file=sys.stderr)
        if not todo:
            print("Every autostart service is running.")

    elif a.cmd == "apps":
        apps_command(cfg, a)

    elif a.cmd == "recipes":
        recipes_command(cfg, a)

    elif a.cmd == "answer":
        print(answer(cfg, a.name, a.answer))

    elif a.cmd == "wait":
        code, message = wait(cfg, a.name, a.timeout)
        print(message)
        sys.exit(code)

    elif a.cmd == "folders":
        f = folders(cfg)
        if a.json:
            json.dump(f, sys.stdout, indent=2)
            print()
        else:
            home = str(HOME)
            for title in ("recent", "nearby", "parents"):
                print(f"{title.capitalize()}:")
                for d in f[title]:
                    print("  " + d.replace(home, "~", 1))

    elif a.cmd == "accounts":
        accounts_command(cfg, a)

    elif a.cmd == "autostart":
        need(cfg, a.name)["autostart"] = a.value == "on"
        save(cfg)
        print(f"Autostart for '{a.name}' is {a.value}.")

    elif a.cmd == "attach":
        if not has_session(a.name):
            raise TendError(f"'{a.name}' isn't running.")
        verb = "switch-client" if os.environ.get("TMUX") else "attach"
        os.execvp("tmux", ["tmux", verb, "-t", f"={a.name}"])

    elif a.cmd == "open":
        open_in_terminal(cfg, a.name)

    elif a.cmd == "terminal":
        if a.app is not None or a.attach is not None:
            set_terminal(cfg, a.app, a.attach)
        t = terminal_settings(cfg)
        if a.json:
            json.dump(t, sys.stdout, indent=2)
            print()
        else:
            print(f"App:    {t['app']}")
            print(f"Attach: {t['attach']}" + (f"  ({t['mode']})" if t["mode"] != "custom" else ""))


if __name__ == "__main__":
    try:
        main()
    except TendError as e:
        print(f"tend: {e}", file=sys.stderr)
        sys.exit(1)

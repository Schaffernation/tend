#!/usr/bin/env python3
"""tend: keep a list of long-running tmux sessions, and restore them.

Each tracked session has a name, a folder, and a command. tend starts a login
shell in a tmux session and types the command into it, so the shell loads
your usual environment and stays open if the command exits.

tend recognizes programs from a list of apps. For each tmux session, it walks
the process tree under the pane's shell and looks for a process that matches
an app, by executable name or path. Claude Code is built in: when a session
runs Claude, tend records the Claude session ID, so a restore reattaches to
the same conversation instead of starting a new one. You can add your own
apps with `tend apps add`.

Usage:
  tend ls [--json]                 List tracked sessions, then tmux sessions
                                   tend doesn't track.
  tend folders [--json]            Suggest folders for a new session: recent
                                   ones, the ones next to them, and their
                                   parent folders.
  tend new [APP] [--dir D] [--mkdir] [--name N] [--no-autostart]
           [--no-restore-conversation]
           [--setup CMD | --recipe ID [--input TEXT]] [-- COMMAND...]
                                   Track and start a new session. Runs the
                                   app's launch command (like `claude rc`), or
                                   COMMAND. Picks a free name from the folder.
                                   --setup runs CMD in the folder once first,
                                   like `git clone URL .`; --recipe runs a
                                   saved setup, with TEXT for its {input}.
  tend recipes [--json]            List saved setups for `tend new --recipe`.
  tend recipes add ID --setup CMD [--name NAME] [--input LABEL]
                                   Save a setup. {input} in CMD is replaced
                                   with the --input you give `tend new`.
  tend recipes rm ID               Remove a setup you saved.
  tend answer NAME ANSWER          Answer the question a session is waiting
                                   on, like Claude's trust prompt (yes or no).
  tend wait NAME [--timeout S]     Wait until a session is ready (for Claude,
                                   connected), is waiting on a question, or
                                   has exited. Exit status: 0 ready, 1 exited,
                                   2 question, 3 timed out.
  tend add [NAME] [--dir D] [--no-autostart] [--no-restore-conversation]
           [--start] [-- COMMAND...]
                                   Track a session. With no command, tend
                                   copies the command from the running tmux
                                   session of that name.
  tend snapshot [NAME...]          Track running tmux sessions (default: all).
  tend rm NAME [--stop]            Stop tracking a session.
  tend start NAME [--fresh]        Start a tracked session. Resumes its app,
                                   like Claude, unless --fresh or the session
                                   doesn't restore conversations.
  tend stop NAME                   Close the session's tmux session.
  tend restart NAME [--fresh]      Stop, then start. Works from inside the
                                   session it restarts.
  tend history NAME [--json]       List the conversations a session has run
                                   (Claude Remote Control), newest first.
  tend resume NAME [ID]            Bring back a past conversation, the latest
                                   by default, after Remote Control has
                                   forgotten it. It runs in single-session
                                   mode; a later restart returns to server
                                   mode and keeps it. If it can't come back,
                                   as after a reboot, tend starts the session
                                   the usual way and lists the conversation
                                   under `tend dropped`.
  tend dropped [--json]            List conversations that were dropped when
                                   their session restarted, as Remote Control
                                   chats are after a reboot.
  tend recover NAME ID [--as N]    Reopen a dropped conversation in a new
                                   session that tend doesn't autostart. Its
                                   background tasks don't come back.
  tend dismiss NAME ID | --all     Take conversations off the dropped list.
  tend restore [--once]            Start every tracked session that's set to
                                   restore and isn't running. With --once, do
                                   nothing if tend already restored since the
                                   Mac started.
  tend autostart NAME on|off       Turn restore on or off for a session.
  tend restore-conversation NAME on|off
                                   Choose whether tend brings back a session's
                                   conversation (on by default). When it's
                                   off, tend starts the session's plain
                                   command, and doesn't record its
                                   conversations or list them as dropped.
  tend accounts [add|rm USER] [--json]
                                   Watch other accounts on this Mac, and
                                   warn when one isn't logged in or isn't
                                   running Tend.
  tend apps [--json]               List the apps tend recognizes (Claude is
                                   built in).
  tend apps add PROGRAM [--id ID] [--name NAME] [--icon ICON]
                                   Recognize another program, by name or path.
                                   ICON is a bundle ID or a .app or image
                                   path, for the menu bar app to show.
  tend apps enable|disable ID      Turn recognition of an app on or off.
  tend apps rm ID                  Remove an app you added.
  tend attach NAME                 Attach to the session in this terminal.
  tend open NAME                   Open the session in a new terminal window.
  tend terminal [--app APP] [--attach PRESET|COMMAND] [--json]
                                   Show or change the terminal app and the
                                   command `tend open` runs. The "control"
                                   preset runs tmux -CC for iTerm2's tmux
                                   integration.
  tend config [--json]             Show where tend keeps its files.

For a command's flags, run `tend COMMAND --help`.

Config: ~/.config/tend/sessions.json (override with TEND_CONFIG).

Source: https://github.com/schaffernation/tend
"""

import sys

# Checked before anything else, so an old Python gets a clear message instead
# of a traceback. The rest of the file avoids syntax newer than 3.8.
if sys.version_info < (3, 8):
    sys.exit("tend needs Python 3.8 or later.")

import argparse
import contextlib
import ctypes
import fcntl
import fnmatch
import functools
import glob
import json
import os
import pwd
import re
import shlex
import shutil
import subprocess
import time
from pathlib import Path

HOME = Path.home()

# ssh commands and GUI apps start with a minimal PATH that doesn't include
# Homebrew or ~/.local/bin. Add those folders after the ones already there, so
# your own PATH order still wins.
EXTRA_PATH = [
    f"{HOME}/.local/bin",
    "/opt/homebrew/bin",
    "/usr/local/bin",
    "/usr/bin",
    "/bin",
    "/usr/sbin",
    "/sbin",
]


def extend_path():
    current = [p for p in os.environ.get("PATH", "").split(os.pathsep) if p]
    os.environ["PATH"] = os.pathsep.join(current + [p for p in EXTRA_PATH if p not in current])


extend_path()

SHELLS = {"zsh", "bash", "sh", "fish", "login"}
TERMINALS = ["iTerm", "Terminal"]
# Named attach commands for `tend terminal --attach`. "control" uses tmux
# control mode, which iTerm2 turns into native windows and tabs.
ATTACH_PRESETS = {
    "tmux": "{tmux} attach -t {target}",
    "control": "{tmux} -CC attach -t {target}",
}


class TendError(Exception):
    """An error tend reports as a one-line message, without a traceback."""


# ---------------------------------------------------------------- files
#
# tend keeps two files in ~/.config/tend: the config (sessions.json), which
# you can edit, and state.json, which tend keeps for itself. Both are written
# whole, to a temporary file that then replaces the old one, so a reader never
# sees half a file. Changes happen under a lock (see `locked`), so two tend
# processes, like the menu bar app's poll and a command you run, can't
# overwrite each other's changes.

CONFIG_DIR = HOME / ".config/tend"


def config_path():
    """The config file. Earlier versions called it services.json, and tend
    keeps using that file if it's the one that exists."""
    if "TEND_CONFIG" in os.environ:
        return Path(os.environ["TEND_CONFIG"]).expanduser()
    current, legacy = CONFIG_DIR / "sessions.json", CONFIG_DIR / "services.json"
    return legacy if legacy.exists() and not current.exists() else current


CONFIG = config_path()
STATE = CONFIG.with_name("state.json")
LOCK = CONFIG.with_name(".tend.lock")

# The config's list of tracked sessions. Earlier versions stored it under
# "services"; tend reads either, and writes back the one the file used.
SESSIONS_KEY = "sessions"
LEGACY_SESSIONS_KEY = "services"
_file_sessions_key = SESSIONS_KEY


def default_config():
    return {
        # Terminal app for `tend open`: "iTerm" or "Terminal".
        "terminal": "iTerm" if Path("/Applications/iTerm.app").exists() else "Terminal",
        # Command that `tend open` runs in the new terminal window. {tmux} is
        # the path to tmux, {target} is the quoted tmux target (=name), and
        # {name} is the quoted session name. See ATTACH_PRESETS.
        "attach_command": ATTACH_PRESETS["tmux"],
        # Launch agent that owns the tmux server, like "com.example.tmux-server".
        # If the server isn't running, tend kickstarts this agent before it
        # starts a session. With null, tend lets tmux start the server itself.
        "tmux_launch_agent": None,
        SESSIONS_KEY: [],
    }


_lock_depth = 0


@contextlib.contextmanager
def locked():
    """Hold tend's lock while you read, change, and save a file.

    The lock is reentrant within one process, so a function that takes it can
    call another that does.
    """
    global _lock_depth
    if _lock_depth == 0:
        LOCK.parent.mkdir(parents=True, exist_ok=True)
        handle = open(LOCK, "a")
        fcntl.flock(handle, fcntl.LOCK_EX)
    _lock_depth += 1
    try:
        yield
    finally:
        _lock_depth -= 1
        if _lock_depth == 0:
            handle.close()  # Closing the file releases the lock.


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    tmp.replace(path)


def load():
    global _file_sessions_key
    if not CONFIG.exists():
        return default_config()
    try:
        cfg = json.loads(CONFIG.read_text())
    except json.JSONDecodeError as e:
        raise TendError(f"{CONFIG} isn't valid JSON: {e.msg} at line {e.lineno}, column {e.colno}.")
    except OSError as e:
        raise TendError(f"can't read {CONFIG}: {e.strerror}.")
    if not isinstance(cfg, dict):
        raise TendError(f'{CONFIG} needs to hold a JSON object, like {{"sessions": []}}.')
    if LEGACY_SESSIONS_KEY in cfg and SESSIONS_KEY not in cfg:
        cfg[SESSIONS_KEY] = cfg.pop(LEGACY_SESSIONS_KEY)
        _file_sessions_key = LEGACY_SESSIONS_KEY
    for key, value in default_config().items():
        cfg.setdefault(key, value)
    return cfg


def save(cfg):
    write_json(CONFIG, {(_file_sessions_key if k == SESSIONS_KEY else k): v for k, v in cfg.items()})


@contextlib.contextmanager
def edit_config():
    """Load the config, let the caller change it, and save it, under the lock.

    Loading inside the lock means a change that another tend process saved in
    the meantime is kept. If the caller raises, nothing is saved.
    """
    with locked():
        cfg = load()
        yield cfg
        save(cfg)


def load_state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(state):
    write_json(STATE, state)


@contextlib.contextmanager
def edit_state():
    """Like edit_config, for state.json. Saves only if something changed."""
    with locked():
        state = load_state()
        before = json.dumps(state, sort_keys=True)
        yield state
        if json.dumps(state, sort_keys=True) != before:
            save_state(state)


def boot_time():
    """When this Mac last started, in seconds since the epoch, or None."""
    r = subprocess.run(["sysctl", "-n", "kern.boottime"], capture_output=True, text=True)
    m = re.search(r"sec = (\d+)", r.stdout)
    return int(m.group(1)) if m else None


def restored_this_boot():
    boot = boot_time()
    return boot is not None and load_state().get("restored_boot") == boot


def mark_restored():
    with edit_state() as state:
        state["restored_boot"] = boot_time()


# ---------------------------------------------------------------- history
#
# state.json keeps three records of conversations:
#
#   history   The conversations each session has run, for `tend history` and
#             `tend resume`.
#   live      The app process each session ran at the last status check, and
#             its conversations.
#   dropped   Conversations that stopped when their session's app came back
#             as a new process, like after a reboot, for `tend recover`.

HISTORY_LIMIT = 20
# How often tend refreshes a conversation's last_seen time, in seconds.
HISTORY_REFRESH = 600
# How long tend lists a dropped conversation, in seconds.
DROPPED_KEEP = 7 * 86400
# A plain restart reconnects a conversation a few seconds after the app
# starts, so tend shows a dropped conversation only after this many seconds.
DROPPED_SETTLE = 30


def update_history(history, seen, now):
    """Add the conversations in `seen` ({name: [conversation]}) to `history`.

    Each session keeps its last HISTORY_LIMIT conversations, newest first,
    with when tend first and last saw them.
    """
    for name, conversations in seen.items():
        entries = history.setdefault(name, [])
        for conv in conversations:
            entry = next((e for e in entries if e["id"] == conv["id"]), None)
            if entry is None:
                entries.append(
                    {
                        "id": conv["id"],
                        "label": conv["label"],
                        "recover": conv.get("recover"),
                        "first_seen": now,
                        "last_seen": now,
                    }
                )
            elif (
                now - entry["last_seen"] >= HISTORY_REFRESH
                or entry.get("label") != conv["label"]
                or entry.get("recover") != conv.get("recover")
            ):
                entry.update(label=conv["label"], recover=conv.get("recover"), last_seen=now)
        entries.sort(key=lambda e: -e["last_seen"])
        del entries[HISTORY_LIMIT:]


def update_live(state, seen, boot, now):
    """Notice conversations that were dropped when their session restarted.

    `seen` is {name: {pid, dir, chats}} for each running tracked session with
    an app. When a session's app comes back as a new process (a new PID, or
    the same PID after a reboot), a conversation that ran under the old one
    and doesn't run now was dropped: it goes on the dropped list, with the
    command that recovers it. A dropped conversation that runs again,
    anywhere, comes off the list.
    """
    live = state.setdefault("live", {})
    dropped = state.setdefault("dropped", [])
    for name, current in seen.items():
        previous = live.get(name)
        if previous and (previous.get("pid"), previous.get("boot")) != (current["pid"], boot):
            running_here = {c["id"] for c in current["chats"]}
            for conv in previous.get("chats", []):
                if (
                    conv["id"] in running_here
                    or not conv.get("recover")
                    or any(d["id"] == conv["id"] for d in dropped)
                ):
                    continue
                dropped.append(
                    {
                        "session": name,
                        "dir": previous.get("dir") or current["dir"],
                        "id": conv["id"],
                        "label": conv.get("label"),
                        "recover": conv["recover"],
                        "dropped_at": now,
                    }
                )
        live[name] = {"pid": current["pid"], "boot": boot, "dir": current["dir"], "chats": current["chats"]}
    running = {c["id"] for current in seen.values() for c in current["chats"]}
    dropped[:] = [d for d in dropped if d["id"] not in running and now - d["dropped_at"] < DROPPED_KEEP]


def record_conversations(seen, live):
    """Save what a status check saw: `seen` for history, `live` for update_live."""
    if not seen and not live:
        return
    now = int(time.time())
    with edit_state() as state:
        update_history(state.setdefault("history", {}), seen, now)
        if live:
            update_live(state, live, boot_time(), now)


def forget_live(name):
    """After you stop a session yourself, its conversations don't count as dropped."""
    with edit_state() as state:
        state.get("live", {}).pop(name, None)


def history_for(name):
    return load_state().get("history", {}).get(name, [])


def dropped_entry(entry):
    """A dropped-list entry in the current format. Earlier versions named the
    session's field "service"."""
    if "session" not in entry and "service" in entry:
        entry = {**entry, "session": entry["service"]}
        del entry["service"]
    return entry


def dropped_list(settled=True):
    """The dropped conversations. With settled, only those that have stayed
    dropped for DROPPED_SETTLE seconds."""
    now = int(time.time())
    return [
        dropped_entry(d)
        for d in load_state().get("dropped", [])
        if now - d["dropped_at"] < DROPPED_KEEP and (not settled or now - d["dropped_at"] >= DROPPED_SETTLE)
    ]


def drop_conversation(cfg, name, entry):
    """Put a conversation from a session's history on the dropped list.

    Returns whether it's on the list.
    """
    if not entry.get("recover"):
        return False
    session = find(cfg, name)
    with edit_state() as state:
        dropped = state.setdefault("dropped", [])
        if not any(d["id"] == entry["id"] for d in dropped):
            dropped.append(
                {
                    "session": name,
                    "dir": session and session["dir"],
                    "id": entry["id"],
                    "label": entry.get("label"),
                    "recover": entry["recover"],
                    "dropped_at": int(time.time()),
                }
            )
    return True


def dismiss(name=None, conversation=None):
    """Take conversations off the dropped list: one, or every one if
    conversation is None. Returns how many it took off."""

    def matches_request(entry):
        if conversation is None:
            return True
        entry = dropped_entry(entry)
        return entry["id"] == conversation and (not name or entry["session"] == name)

    with edit_state() as state:
        dropped = state.get("dropped", [])
        keep = [d for d in dropped if not matches_request(d)]
        if len(keep) == len(dropped):
            raise TendError(
                f"no dropped conversation {conversation}." if conversation else "no dropped conversations."
            )
        state["dropped"] = keep
    return len(dropped) - len(keep)


def dismiss_session(name):
    """Take every conversation from one session off the dropped list."""
    with edit_state() as state:
        state["dropped"] = [d for d in state.get("dropped", []) if dropped_entry(d)["session"] != name]


# ---------------------------------------------------------------- lookups


def find(cfg, name):
    """The tracked session named `name`, or None."""
    return next((s for s in cfg[SESSIONS_KEY] if s["name"] == name), None)


def restores_conversation(session):
    """Whether tend brings back this session's conversation. When it doesn't,
    tend starts the plain command and doesn't record conversations."""
    return session.get("restore_conversation", True)


def need(cfg, name):
    """The tracked session named `name`. Raises if there isn't one."""
    session = find(cfg, name)
    if not session:
        raise TendError(f"no tracked session named '{name}'. Run `tend ls` to see them.")
    return session


def session_name(text):
    """A tmux session name made from text. tmux names can't contain . or :."""
    return re.sub(r"[.:]", "-", text)


def short_path(path):
    """A path with the home folder shown as ~."""
    home = str(HOME)
    if path == home or path.startswith(home + "/"):
        return "~" + path[len(home):]
    return path


# ---------------------------------------------------------------- tmux


def tmux(*args, check=True):
    if not shutil.which("tmux"):
        raise TendError("tmux isn't installed. Install it with: brew install tmux")
    r = subprocess.run(["tmux", *args], capture_output=True, text=True)
    if check and r.returncode:
        raise TendError(r.stderr.strip() or f"tmux {args[0]} failed")
    return r


def ensure_server(cfg):
    """Make sure the tmux server runs in the launch agent, if one is set."""
    if tmux("info", check=False).returncode == 0:
        return
    agent = cfg.get("tmux_launch_agent")
    if not agent:
        return
    target = f"gui/{os.getuid()}/{agent}"
    subprocess.run(["launchctl", "kickstart", target], capture_output=True)
    for _ in range(30):
        if tmux("info", check=False).returncode == 0:
            return
        time.sleep(0.1)
    raise TendError(
        f"the tmux server isn't running, and the {agent} launch agent didn't start it. "
        f"Check it with: launchctl print {target}"
    )


def has_session(name):
    return tmux("has-session", "-t", f"={name}", check=False).returncode == 0


def type_command(name, command):
    """Type a command into a session's first pane, and press Enter."""
    tmux("send-keys", "-t", f"={name}:", "-l", "--", command)
    tmux("send-keys", "-t", f"={name}:", "Enter")


def pane_tail(name, n=3):
    """The last lines a session's pane shows, for an error message."""
    r = tmux("capture-pane", "-p", "-J", "-t", f"={name}:", check=False)
    lines = [line.rstrip() for line in r.stdout.splitlines() if line.strip()] if r.returncode == 0 else []
    return "\n".join(lines[-n:])


PANE_FORMAT = "\t".join(
    [
        "#{session_name}",
        "#{window_index}",
        "#{pane_index}",
        "#{pane_pid}",
        "#{pane_current_command}",
        "#{pane_current_path}",
        "#{session_attached}",
        "#{session_created}",
    ]
)


def tmux_panes():
    """Return {session: [pane, ...]}, with the first pane first."""
    r = tmux("list-panes", "-a", "-F", PANE_FORMAT, check=False)
    if r.returncode:
        return {}
    sessions = {}
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 8:
            continue
        session, window, pane, pid, command, path, attached, created = parts
        sessions.setdefault(session, []).append(
            {
                "window": int(window),
                "pane": int(pane),
                "pid": int(pid),
                "cmd": command,
                "path": path,
                "attached": attached != "0",
                "created": int(created),
            }
        )
    for panes in sessions.values():
        panes.sort(key=lambda p: (p["window"], p["pane"]))
    return sessions


# ---------------------------------------------------------------- processes


def process_table():
    """Return ({pid: process}, {parent pid: [child pid, ...]})."""
    r = subprocess.run(["ps", "-ax", "-o", "pid=,ppid=,command="], capture_output=True, text=True)
    procs, children = {}, {}
    for line in r.stdout.splitlines():
        parts = line.split(None, 2)
        if len(parts) < 2:
            continue
        pid, ppid = int(parts[0]), int(parts[1])
        procs[pid] = {"pid": pid, "ppid": ppid, "command": parts[2] if len(parts) > 2 else ""}
        children.setdefault(ppid, []).append(pid)
    for kids in children.values():
        kids.sort()
    return procs, children


def split_command(command):
    """A command line split into arguments, as well as it can be."""
    try:
        return shlex.split(command)
    except ValueError:
        return command.split()


def program_name(arg0):
    """The program name in argv[0]. A login shell's argv[0] starts with -."""
    return os.path.basename(arg0).lstrip("-")


def is_shell(command):
    """Whether a command line runs a shell, like `-zsh` or `/bin/bash -l`."""
    args = split_command(command)
    return bool(args) and program_name(args[0]) in SHELLS


def descendants(pid, children):
    """Every process under pid, breadth first."""
    out, queue = [], list(children.get(pid, []))
    while queue:
        child = queue.pop(0)
        out.append(child)
        queue.extend(children.get(child, []))
    return out


try:
    _libproc = ctypes.CDLL("/usr/lib/libproc.dylib")
except OSError:
    _libproc = None


@functools.lru_cache(maxsize=None)
def exe_path(pid):
    """Return the real path of a process's executable, like /bin/zsh."""
    if not _libproc:
        return ""
    buf = ctypes.create_string_buffer(4096)
    if _libproc.proc_pidpath(pid, buf, 4096) > 0:
        return buf.value.decode(errors="replace")
    return ""


# ---------------------------------------------------------------- apps
#
# An app tells tend how to recognize a program in a tmux session, and,
# optionally, how to read its state and resume it. Fields:
#
#   id, name     Short ID and display name.
#   icon         Optional. The picture the app shows for it: a bundle ID
#                like "io.tailscale.ipn.macos", or the path to a .app or an
#                image file.
#   match        How to recognize the process. It matches if any rule does:
#     names        Executable names, compared with argv[0] and the real
#                  executable's file name.
#     paths        Glob patterns, compared with the real executable path.
#                For a script run by an interpreter (like `sh script`),
#                both rules also compare the script's name and real path.
#   modes        Optional. The first mode whose `args` contains argv[1]
#                wins; a mode without `args` matches anything. A mode can set
#                `resume`, a command template filled in from the metadata,
#                plus {command}: the running command without strip_flags.
#   strip_flags  Optional. Flags to drop from the saved command, mapped to
#                how many values follow them, so a fresh start stays fresh.
#   launch       Optional. The command `tend new` runs to start a new
#                instance, like `claude rc`.
#   reattach     Optional. The command `tend resume` runs to bring back a
#                past conversation, with {id} from metadata `id_field`.
#   recover      Optional. The command `tend recover` runs, in a new
#                session, to bring back a conversation that was dropped when
#                its session restarted. Filled in from that conversation's
#                metadata, like `resume`.
#   release_wait Optional. After tend stops a process started with one of
#                `args`, it waits `seconds` before starting the app again in
#                that folder, so the old one can let go of it.
#   preflight    Optional. A check tend runs before it starts the app in a
#                folder. The only check so far is "claude-trust".
#   questions    Optional. Prompts the app can stop and wait on. tend looks
#                at the last line of the pane, and the menu bar app offers
#                the answers as buttons. Each has:
#     id           Short ID.
#     match        A regular expression for the last non-empty line. Named
#                  groups fill in {name} in `text`.
#     text         The question to show.
#     answers      [{id, label, keys}]: `tend answer NAME ID` types keys,
#                  then Enter.
#   metadata     Optional. JSON files the program writes about itself:
#     glob         Files to read.
#     pid_field    Field with the PID of a process in the session. tend
#                  matches a file to a session by this PID.
#     status_field, label_field   Fields to show in the app.
#     id_field     Field with a conversation ID. tend keeps a history of
#                  these per session, for `tend history` and `tend resume`.
#     order_field  If several files match a session, the lowest value wins.
#
# Only the topmost matching process counts, so a program that starts copies
# of itself shows up once.
#
# Claude Code doesn't document its session files, its ~/.claude.json fields,
# or its trust prompt. The Claude profile below depends on all three, so a
# Claude Code update can change what tend sees.

BUILTIN_APPS = [
    {
        "id": "claude",
        "name": "Claude",
        "icon": "com.anthropic.claudefordesktop",
        "match": {"names": ["claude"], "paths": ["*/claude/versions/*"]},
        "modes": [
            {
                "id": "remote-control",
                "args": ["rc", "remote-control"],
                # Restart the same command. Remote Control keeps its
                # environment, so a plain restart reconnects the last
                # conversation and stays in server mode, where the app can
                # start new sessions. --session-id and --continue reconnect
                # in single-session mode, which turns that off.
                "resume": "{command}",
            },
            {"id": "interactive", "resume": "{command} --resume {sessionId}"},
        ],
        "launch": "claude rc",
        # Brings a conversation back after Remote Control has forgotten it,
        # in single-session mode. A later plain restart returns to server
        # mode and keeps the conversation.
        "reattach": "claude remote-control --session-id {id}",
        # Reopens a conversation from its transcript on this Mac and connects
        # it to the Claude app. This works after a reboot, when Remote
        # Control can no longer reattach to it.
        "recover": "claude --resume {sessionId} --remote-control",
        "release_wait": {"args": ["--session-id", "-c", "--continue"], "seconds": 45},
        "preflight": "claude-trust",
        "questions": [
            {
                # claude rc asks this in a folder you haven't trusted.
                "id": "trust",
                "match": r"^Trust (?P<folder>.+)\? \[y/N\]\s*$",
                "text": "Trust {folder} in Claude Code? Sessions there can read, edit, and run files.",
                "answers": [
                    {"id": "yes", "label": "Trust", "keys": "y"},
                    {"id": "no", "label": "Don't trust", "keys": "n"},
                ],
            }
        ],
        "strip_flags": {"-c": 0, "--continue": 0, "--session-id": 1, "-r": 1, "--resume": 1},
        "metadata": {
            "glob": "~/.claude/sessions/*.json",
            "pid_field": "pid",
            "status_field": "status",
            "label_field": "name",
            "id_field": "bridgeSessionId",
            "order_field": "startedAt",
        },
    }
]


def apps(cfg):
    """Built-in apps with your changes applied, then your own apps."""
    custom = {app["id"]: app for app in cfg.get("apps", [])}
    out = [{**builtin, **custom.pop(builtin["id"], {}), "builtin": True} for builtin in BUILTIN_APPS]
    out.extend({**app, "builtin": False} for app in custom.values())
    for app in out:
        app.setdefault("enabled", True)
    return out


def app_by_id(cfg, app_id):
    return next((app for app in apps(cfg) if app["id"] == app_id), None)


def expected_app(cfg, command):
    """The app a command starts, by the name of its program, or None."""
    args = split_command(command or "")
    program = os.path.basename(args[0]) if args else ""
    return next(
        (app for app in apps(cfg) if app["enabled"] and program in app.get("match", {}).get("names", [])),
        None,
    )


# Programs that run a script named by their first argument, like
# `sh ~/.local/bin/tailscale-keepalive`.
INTERPRETERS = {"zsh", "bash", "sh", "fish", "python", "python3", "node", "ruby", "perl"}


def script_path(args):
    """For `INTERPRETER SCRIPT ...`, return the script's real path, or ""."""
    if len(args) < 2 or program_name(args[0]) not in INTERPRETERS:
        return ""
    if args[1].startswith("-") or not os.path.isfile(args[1]):
        return ""
    return os.path.realpath(args[1])


def matches(app, proc):
    """Whether a process is an instance of an app."""
    args = split_command(proc["command"])
    rules = app.get("match", {})
    names = set(rules.get("names", []))
    patterns = rules.get("paths", [])
    if args and program_name(args[0]) in names:
        return True
    for path in (exe_path(proc["pid"]), script_path(args)):
        if path and (
            os.path.basename(path) in names or any(fnmatch.fnmatch(path, p) for p in patterns)
        ):
            return True
    return False


def read_metadata(app):
    """The app's metadata files, each with its PID in `_pid`."""
    spec = app.get("metadata")
    if not spec:
        return []
    out = []
    for path in glob.glob(os.path.expanduser(spec["glob"])):
        try:
            data = json.loads(Path(path).read_text())
            data["_pid"] = int(data[spec.get("pid_field", "pid")])
        except (OSError, ValueError, KeyError, TypeError):
            continue
        out.append(data)
    return out


def pick_mode(app, args):
    """The app's first mode that matches argv[1], or {}."""
    return next(
        (
            mode
            for mode in app.get("modes", [])
            if "args" not in mode or (len(args) > 1 and args[1] in mode["args"])
        ),
        {},
    )


def strip_flags(args, flags):
    """Drop flags (and the values that follow them) from args.

    `flags` maps each flag to how many values follow it. A long flag also
    matches its --flag=value form.
    """
    out, skip = args[:1], 0
    for arg in args[1:]:
        if skip:
            skip -= 1
        elif arg in flags:
            skip = flags[arg]
        elif not any(arg.startswith(f + "=") for f in flags if f.startswith("--")):
            out.append(arg)
    return out


def fill(template, values):
    """A command template filled in from values, or None if one is missing."""
    if not template:
        return None
    try:
        return template.format_map(values)
    except (KeyError, IndexError, ValueError):
        return None


def describe(app, proc, pids, metadata):
    """What tend knows about one running app."""
    args = split_command(proc["command"])
    mode = pick_mode(app, args)
    spec = app.get("metadata") or {}
    mine = sorted(
        (d for d in metadata if d["_pid"] in pids),
        key=lambda d: d.get(spec.get("order_field", "_pid"), 0),
    )
    meta = mine[0] if mine else {}

    # The saved command drops resume flags, so a fresh start stays fresh.
    command = shlex.join(strip_flags(args, app.get("strip_flags", {})))
    id_field = spec.get("id_field")
    label_field = spec.get("label_field", "")
    return {
        "id": app["id"],
        "name": app.get("name", app["id"]),
        "icon": app.get("icon"),
        "mode": mode.get("id"),
        "command": command,
        "status": meta.get(spec.get("status_field", "")),
        "label": meta.get(label_field),
        "resume": fill(mode.get("resume"), {**meta, "command": command}) if meta else None,
        "instances": len(mine),
        "pid": proc["pid"],
        "args": args,
        "conversations": [
            {"id": d[id_field], "label": d.get(label_field), "recover": fill(app.get("recover"), d)}
            for d in mine
            if id_field and d.get(id_field)
        ],
    }


def find_app(name, panes, procs, children, app_list, metadata):
    """The first app running in a tmux session, described, or None."""
    for pane in panes:
        # The pane's own process counts too, for a session started with a
        # command instead of a shell, like `tmux new-session CMD`.
        pids = [pane["pid"]] + descendants(pane["pid"], children)
        for pid in pids:
            proc = procs.get(pid)
            if not proc:
                continue
            parent = procs.get(proc["ppid"])
            for app in app_list:
                # Skip a process whose parent is the same app: the topmost
                # one is the command you typed.
                if matches(app, proc) and not (parent and matches(app, parent)):
                    found = describe(app, proc, set(pids), metadata.get(app["id"], []))
                    found["pane"] = f"={name}:{pane['window']}.{pane['pane']}"
                    found["question"] = pending_question(app, found["pane"])
                    return found
    return None


def inspect_session(name, panes, procs, children, app_list, metadata):
    """Work out what runs in a tmux session."""
    main_pane = panes[0]
    kids = [pid for pid in children.get(main_pane["pid"], []) if pid in procs]
    pane_proc = procs.get(main_pane["pid"])
    if kids:
        foreground = procs[kids[0]]["command"]
    elif pane_proc and pane_proc["command"] and not is_shell(pane_proc["command"]):
        # The session runs its command directly, without a shell.
        foreground = pane_proc["command"]
    else:
        foreground = None
    app = find_app(name, panes, procs, children, app_list, metadata)
    return {
        "state": "running" if app or foreground else "exited",
        "foreground": foreground,
        "path": main_pane["path"],
        "attached": any(p["attached"] for p in panes),
        "app": app,
    }


def match_question(questions, line):
    """The first question whose pattern matches line, filled in, or None."""
    for question in questions:
        m = re.search(question["match"], line)
        if m:
            return {
                "id": question["id"],
                "text": question["text"].format_map({k: v or "" for k, v in m.groupdict().items()}),
                "answers": [{"id": a["id"], "label": a["label"]} for a in question["answers"]],
            }
    return None


def pending_question(app, target):
    """Return the question the app is waiting on in a pane, or None."""
    questions = app.get("questions")
    if not questions:
        return None
    r = tmux("capture-pane", "-p", "-t", target, check=False)
    lines = [line for line in r.stdout.splitlines() if line.strip()] if r.returncode == 0 else []
    return match_question(questions, lines[-1]) if lines else None


def detected_command(info):
    """The command to save for an untracked tmux session, or None for a shell."""
    if info["app"]:
        return info["app"]["command"]
    foreground = info["foreground"]
    return foreground if foreground and not is_shell(foreground) else None


# ---------------------------------------------------------------- status


def status(cfg):
    """Return a row for each tracked session, then each untracked tmux session.

    This only reads. To save the resume commands and conversations it found,
    pass the rows to `sync`.
    """
    panes = tmux_panes()
    procs, children = process_table()
    app_list = [app for app in apps(cfg) if app["enabled"]]
    metadata = {app["id"]: read_metadata(app) for app in app_list}
    rows = []

    def row(name, directory, **fields):
        return {
            "name": name,
            "dir": directory,
            # Whether the session is named after its folder, so the app can
            # show the parent folder instead of repeating the name.
            "named_after_dir": bool(directory) and session_name(Path(directory).name) == name,
            **fields,
        }

    tracked = set()
    for session in cfg[SESSIONS_KEY]:
        name = session["name"]
        tracked.add(name)
        info = (
            inspect_session(name, panes[name], procs, children, app_list, metadata)
            if name in panes
            else {"state": "stopped", "attached": False, "app": None}
        )
        rows.append(
            row(
                name,
                session["dir"],
                command=session.get("command"),
                resume=session.get("resume"),
                autostart=session.get("autostart", True),
                restore_conversation=restores_conversation(session),
                managed=True,
                state=info["state"],
                attached=info["attached"],
                app=info["app"],
            )
        )

    for name, session_panes in sorted(panes.items()):
        if name in tracked:
            continue
        info = inspect_session(name, session_panes, procs, children, app_list, metadata)
        rows.append(
            row(
                name,
                info["path"],
                command=detected_command(info),
                resume=info["app"] and info["app"]["resume"],
                autostart=False,
                restore_conversation=True,
                managed=False,
                state=info["state"],
                attached=info["attached"],
                app=info["app"],
            )
        )
    return rows


def sync(cfg, rows):
    """Save what a status check found, so a later restore uses the latest
    conversation: each tracked session's resume command (for Claude, the
    command that reconnects it), the conversations it has run, and which
    conversations a restart dropped.

    Skips sessions that don't restore conversations. Updates `cfg` and `rows`
    to match what it saved.
    """
    running = [r for r in rows if r["managed"] and r["app"] and r["restore_conversation"]]
    updates = {
        r["name"]: r["app"]["resume"]
        for r in running
        if r["app"]["resume"] and r["app"]["resume"] != r["resume"]
    }
    if updates:
        with edit_config() as fresh:
            for c in (fresh, cfg):
                for name, resume in updates.items():
                    session = find(c, name)
                    if session:
                        session["resume"] = resume
        for r in rows:
            if r["name"] in updates:
                r["resume"] = updates[r["name"]]
    record_conversations(
        {r["name"]: r["app"]["conversations"] for r in running if r["app"]["conversations"]},
        {r["name"]: {"pid": r["app"]["pid"], "dir": r["dir"], "chats": r["app"]["conversations"]} for r in running},
    )


def find_row(cfg, name):
    """The status row for a session, tracked or not. Raises if there isn't one."""
    row = next((r for r in status(cfg) if r["name"] == name), None)
    if not row:
        raise TendError(f"no session named '{name}'. Run `tend ls` to see them.")
    return row


# ---------------------------------------------------------------- starting and stopping


def trusted_by_claude(folder, projects):
    """Whether Claude Code trusts folder or a folder that holds it."""
    path = folder
    while True:
        if projects.get(path, {}).get("hasTrustDialogAccepted"):
            return True
        if path == "/":
            return False
        path = os.path.dirname(path)


def preflight(check, folder, name):
    """Return a note about starting an app in folder, or None."""
    if check == "claude-trust":
        # claude rc asks whether to trust a new folder, and waits. In tmux
        # nobody sees the question, so say where to answer it.
        try:
            projects = json.loads((HOME / ".claude.json").read_text()).get("projects", {})
        except (OSError, ValueError):
            return None
        if trusted_by_claude(folder, projects):
            return None
        return (
            f"Claude will ask whether to trust {folder}. Answer in the Tend menu, "
            f"or run `tend answer {name} yes`."
        )
    return None


SETUP_TIMEOUT = 900


def run_setup(command, folder):
    """Run a setup command in folder with your login shell's environment."""
    print(f"Running setup: {command}", flush=True)
    shell = os.environ.get("SHELL") or "/bin/zsh"
    try:
        r = subprocess.run(
            [shell, "-lc", command], cwd=folder, capture_output=True, text=True, timeout=SETUP_TIMEOUT
        )
    except subprocess.TimeoutExpired:
        raise TendError(f"setup didn't finish in {SETUP_TIMEOUT // 60} minutes: {command}")
    if r.returncode:
        tail = (r.stderr.strip() or r.stdout.strip()).splitlines()[-5:]
        raise TendError(f"setup failed (exit {r.returncode}): {command}\n" + "\n".join(tail))


def unique_name(cfg, name):
    """name, or name-2, name-3, and so on, whichever isn't taken."""
    candidate, n = name, 2
    while find(cfg, candidate) or has_session(candidate):
        candidate, n = f"{name}-{n}", n + 1
    return candidate


def start(cfg, session, fresh=False, command=None):
    """Start a tracked session. Uses command if given; otherwise the saved
    resume command, or with fresh or for a session that doesn't restore
    conversations, the saved command."""
    name = session["name"]
    if has_session(name):
        return f"'{name}' is already running."
    if not Path(session["dir"]).is_dir():
        raise TendError(f"{session['dir']} isn't a folder. If it moved, track it again with `tend add`.")
    ensure_server(cfg)
    if not command:
        plain = fresh or not restores_conversation(session)
        command = session.get("command") if plain else (session.get("resume") or session.get("command"))
    tmux("new-session", "-d", "-s", name, "-c", session["dir"])
    if command:
        type_command(name, command)
    return f"Started '{name}'" + (f": {command}" if command else " (shell only).")


def stop(name):
    if not has_session(name):
        return f"'{name}' isn't running."
    tmux("kill-session", "-t", f"={name}")
    return f"Stopped '{name}'."


def stop_for_restart(cfg, name):
    """Stop a session, then wait if its app needs time to let go of the folder.

    Records the latest conversation first, so the restart can resume it.
    Returns the message to print, or None if it printed its own.
    """
    rows = status(cfg)
    sync(cfg, rows)
    row = next((r for r in rows if r["name"] == name), None)
    out = stop(name)
    info = row and row["app"]
    if info:
        release = (app_by_id(cfg, info["id"]) or {}).get("release_wait")
        if release and any(arg in release["args"] for arg in info.get("args", [])):
            print(out)
            print(f"Waiting {release['seconds']} seconds for {info['name']} to let go of the folder…", flush=True)
            time.sleep(release["seconds"])
            return None
    return out


def current_session():
    """The tmux session this process runs in, or None.

    A command handed off to the tmux server runs with TMUX set too, so
    hand_off marks it with TEND_HANDED_OFF.
    """
    if not os.environ.get("TMUX") or os.environ.get("TEND_HANDED_OFF"):
        return None
    r = tmux("display-message", "-p", "#S", check=False)
    return r.stdout.strip() or None


def hand_off(args):
    """Run this tend command from the tmux server instead of this process.

    Stopping the session tend runs in would end tend before it could start
    the session again. The tmux server keeps running.
    """
    command = "TEND_HANDED_OFF=1 " + shlex.join([os.path.realpath(sys.argv[0]), *args])
    if "TEND_CONFIG" in os.environ:
        command = f"TEND_CONFIG={shlex.quote(os.environ['TEND_CONFIG'])} {command}"
    tmux("run-shell", "-b", command)


def adopt(cfg, name, rows):
    """Track a running tmux session, copying its folder and command.

    Returns the new entry, or None if the session is already tracked.
    """
    row = next((r for r in rows if r["name"] == name), None)
    if not row:
        raise TendError(f"no tmux session named '{name}'.")
    if row["managed"] or find(cfg, name):
        return None
    entry = {"name": name, "dir": row["dir"], "command": row["command"], "autostart": True}
    if row["resume"]:
        entry["resume"] = row["resume"]
    cfg[SESSIONS_KEY].append(entry)
    return entry


# ---------------------------------------------------------------- questions


def wait(cfg, name, timeout, command=None):
    """Wait for a session to settle. Return (exit status, message).

    If the session's command starts an app, like `claude`, the session isn't
    ready until tend finds that app: while a login shell starts, it runs
    helper programs that would otherwise look like the command.
    """
    began = time.monotonic()
    deadline = began + timeout
    session = find(cfg, name)
    expect = expected_app(cfg, command or (session and session.get("command")))
    seen_running = False
    while True:
        row = find_row(cfg, name)
        info = row["app"]
        if expect:
            seen_running = seen_running or bool(info and info["id"] == expect["id"])
        else:
            seen_running = seen_running or row["state"] == "running"
        # Right after a start, the shell may not have run the command yet.
        starting = row["state"] == "exited" or (expect and row["state"] == "running")
        if not seen_running and starting and time.monotonic() - began < 10:
            time.sleep(1)
            continue
        if row["state"] != "running" or (expect and not info and not seen_running):
            how = "stopped" if row["state"] == "stopped" else "exited"
            tail = pane_tail(name) if row["state"] != "stopped" else ""
            return 1, f"'{name}' isn't running: its command {how}." + (f"\n{tail}" if tail else "")
        if info and info.get("question"):
            question = info["question"]
            ids = "|".join(a["id"] for a in question["answers"])
            return 2, f"'{name}' is waiting: {question['text']}\nAnswer with `tend answer {name} {ids}`."
        app = info and app_by_id(cfg, info["id"])
        # An app that reports a status is ready once it does; any other
        # running command is ready now.
        reports_status = bool(app and app.get("metadata", {}).get("status_field"))
        if not reports_status or info["status"]:
            what = f"{info['name']} is {info['status']}" if info and info["status"] else "it's running"
            return 0, f"'{name}' is ready: {what}."
        if time.monotonic() >= deadline:
            return 3, f"'{name}' is still starting after {timeout} seconds. Check it with `tend open {name}`."
        time.sleep(2)


def answer(cfg, name, answer_id):
    """Type the answer to the question a session is waiting on."""
    row = find_row(cfg, name)
    question = row["app"] and row["app"].get("question")
    if not question:
        raise TendError(f"'{name}' isn't waiting on a question.")
    app = app_by_id(cfg, row["app"]["id"]) or {}
    spec = next((q for q in app.get("questions", []) if q["id"] == question["id"]), None)
    if not spec:
        raise TendError(f"'{name}' isn't waiting on a question.")
    choice = next((a for a in spec["answers"] if a["id"] == answer_id), None)
    if not choice:
        ids = " or ".join(a["id"] for a in spec["answers"])
        raise TendError(f"answer with {ids}.")
    tmux("send-keys", "-t", row["app"]["pane"], "-l", "--", choice["keys"])
    tmux("send-keys", "-t", row["app"]["pane"], "Enter")
    return f"Answered '{choice['label']}' in '{name}'."


# ---------------------------------------------------------------- terminal


def applescript_string(text):
    """text as an AppleScript string literal."""
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def attach_command(cfg, name, tmux_path):
    """The command `tend open` runs in the new terminal window."""
    return (
        cfg.get("attach_command", ATTACH_PRESETS["tmux"])
        .replace("{tmux}", shlex.quote(tmux_path))
        .replace("{target}", shlex.quote(f"={name}"))
        .replace("{name}", shlex.quote(name))
    )


def open_in_terminal(cfg, name):
    if not has_session(name):
        raise TendError(f"'{name}' isn't running.")
    command = applescript_string(attach_command(cfg, name, shutil.which("tmux")))
    if cfg.get("terminal", "").lower().startswith("iterm"):
        action = f"create window with default profile command {command}"
        script = f'tell application "iTerm"\n  activate\n  {action}\nend tell'
    else:
        script = f'tell application "Terminal"\n  activate\n  do script {command}\nend tell'
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if r.returncode:
        raise TendError(r.stderr.strip())


def terminal_settings(cfg):
    attach = cfg.get("attach_command", ATTACH_PRESETS["tmux"])
    mode = next((k for k, v in ATTACH_PRESETS.items() if v == attach), "custom")
    return {
        "app": cfg.get("terminal"),
        "attach": attach,
        "mode": mode,
        "apps": TERMINALS,
        "presets": ATTACH_PRESETS,
    }


def set_terminal(cfg, app=None, attach=None):
    if app is not None:
        match = next((t for t in TERMINALS if t.lower() == app.lower()), None)
        if not match:
            raise TendError(f"tend can open {' or '.join(TERMINALS)}, not '{app}'.")
        cfg["terminal"] = match
    if attach is not None:
        attach = ATTACH_PRESETS.get(attach, attach).strip()
        if "{target}" not in attach and "{name}" not in attach:
            raise TendError(
                "the attach command needs {target} or {name}, so it knows which session "
                f"to attach to. Or use a preset: {', '.join(ATTACH_PRESETS)}."
            )
        cfg["attach_command"] = attach


# ---------------------------------------------------------------- recipes

# Saved setups for `tend new --recipe`. Entries in the config's `recipes`
# list override these by `id`, or add new ones.
BUILTIN_RECIPES = [
    {
        "id": "clone",
        "name": "Clone a Git repository",
        "setup": "git clone {input} .",
        "input": "Repository URL",
    }
]


def recipes(cfg):
    custom = {r["id"]: r for r in cfg.get("recipes", [])}
    out = [{**b, **custom.pop(b["id"], {}), "builtin": True} for b in BUILTIN_RECIPES]
    out.extend({**r, "builtin": False} for r in custom.values())
    return out


def recipe_command(cfg, recipe_id, text):
    """The setup command for a recipe, with {input} replaced by text, quoted."""
    recipe = next((r for r in recipes(cfg) if r["id"] == recipe_id), None)
    if not recipe:
        raise TendError(f"no recipe with ID '{recipe_id}'. Run `tend recipes` to see them.")
    if "{input}" in recipe["setup"]:
        if not text:
            raise TendError(f"recipe '{recipe_id}' needs --input ({recipe.get('input', 'text')}).")
        return recipe["setup"].replace("{input}", shlex.quote(text))
    return recipe["setup"]


# ---------------------------------------------------------------- folders

# Folder extensions that macOS shows as a single file, like a Pages document.
PACKAGES = {
    ".app", ".bundle", ".framework", ".plugin", ".pages", ".numbers", ".key",
    ".rtfd", ".photoslibrary", ".xcodeproj", ".xcworkspace", ".playground",
    ".logicx", ".band", ".fcpbundle", ".imovielibrary", ".dtbase2", ".sparsebundle",
}


def folders(cfg):
    """Folders to suggest for a new session.

    recent: the folders of tracked sessions and running tmux sessions.
    nearby: the other folders next to them, like your other projects, most
    recently changed first.
    parents: the folders that hold them, most used first, for a new folder.
    """
    recent = sorted({r["dir"] for r in status(cfg) if r["dir"]})
    counts = {}
    for folder in recent:
        parent = str(Path(folder).parent)
        counts[parent] = counts.get(parent, 0) + 1
    parents = sorted(counts, key=lambda p: (-counts[p], p))
    nearby = {}
    for parent in parents:
        try:
            for child in Path(parent).iterdir():
                if (
                    child.is_dir()
                    and not child.name.startswith(".")
                    and child.suffix.lower() not in PACKAGES
                    and str(child) not in recent
                ):
                    nearby[str(child)] = child.stat().st_mtime
        except OSError:
            pass
    return {
        "recent": recent,
        "nearby": sorted(nearby, key=nearby.get, reverse=True),
        "parents": parents,
    }


# ---------------------------------------------------------------- accounts
#
# Other accounts on this Mac that should run their own Tend, like a family
# member's account under fast user switching. tend can't see inside another
# account, but it can see which processes that user runs: a loginwindow
# process means the user is logged in, and a Tend process means their Tend is
# running.


def local_users():
    """People's accounts on this Mac, except the current one: {user: full name}."""
    r = subprocess.run(["dscl", ".", "list", "/Users", "UniqueID"], capture_output=True, text=True)
    me = pwd.getpwuid(os.getuid()).pw_name
    users = {}
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1].isdigit() and int(parts[1]) >= 500:
            user = parts[0]
            if user != me and not user.startswith("_"):
                users[user] = full_name(user)
    return users


def full_name(user):
    try:
        return pwd.getpwnam(user).pw_gecos or user
    except KeyError:
        return user


def runs(user, process):
    """Whether user runs a process with this exact name."""
    return subprocess.run(["pgrep", "-x", "-u", user, process], capture_output=True).returncode == 0


def account_status(user):
    logged_in = runs(user, "loginwindow")
    tend_running = logged_in and runs(user, "Tend")
    account = {
        "user": user,
        "name": full_name(user),
        "logged_in": logged_in,
        "tend_running": tend_running,
        "ok": tend_running,
    }
    account["problem"] = account_problem(account)
    return account


def account_problem(account):
    if not account["logged_in"]:
        return f"{account['name']} isn't logged in, so their sessions aren't running."
    if not account["tend_running"]:
        return f"Tend isn't running for {account['name']}, so their sessions won't restart."
    return None


# ---------------------------------------------------------------- output


def print_json(data):
    json.dump(data, sys.stdout, indent=2)
    print()


def print_table(rows):
    if not rows:
        print("No sessions and no tmux sessions. Start one with `tend new`, or track one with `tend add`.")
        return
    table = [("NAME", "STATE", "APP", "AUTO", "DIR", "COMMAND")]
    for r in rows:
        info = r["app"]
        table.append(
            (
                r["name"] + ("" if r["managed"] else " *"),
                r["state"] + (" (attached)" if r["attached"] else ""),
                f"{info['name']} {info['status'] or ''}".strip() if info else "-",
                ("yes" if r["autostart"] else "no") if r["managed"] else "-",
                short_path(r["dir"]),
                r["command"] or "(shell)",
            )
        )
    # Pad every column but the last, so long commands don't widen the table.
    widths = [max(len(line[i]) for line in table) for i in range(5)]
    for line in table:
        print("  ".join(v.ljust(w) for v, w in zip(line[:5], widths)) + "  " + line[5])
    if any(not r["managed"] for r in rows):
        print("\n* not tracked. Run `tend snapshot` to track every running session.")
    for r in rows:
        question = r["app"] and r["app"].get("question")
        if question:
            ids = "|".join(a["id"] for a in question["answers"])
            print(f"\n{r['name']} is waiting: {question['text']}\n  Answer with `tend answer {r['name']} {ids}`.")


def print_account_problems(cfg):
    for user in cfg.get("accounts", []):
        problem = account_status(user)["problem"]
        if problem:
            print(f"Warning: {problem}")


def ago(timestamp):
    seconds = int(time.time()) - timestamp
    for unit, size in (("day", 86400), ("hour", 3600), ("minute", 60)):
        if seconds >= size:
            n = seconds // size
            return f"{n} {unit}{'s' if n != 1 else ''} ago"
    return "just now"


# ---------------------------------------------------------------- commands
#
# Each command is a function that takes the config, as loaded when tend
# started, and the parsed options. A command that changes the config does so
# in an `edit_config()` block, which reloads it under the lock.


def cmd_ls(cfg, opts):
    rows = status(cfg)
    sync(cfg, rows)
    if opts.json:
        print_json(rows)
    else:
        print_table(rows)
        print_account_problems(cfg)


def cmd_new(cfg, opts):
    folder = str(Path(opts.dir).expanduser().resolve())
    if opts.setup and opts.recipe:
        raise TendError("give --setup or --recipe, not both.")
    setup = opts.setup or (opts.recipe and recipe_command(cfg, opts.recipe, opts.input))
    if opts.mkdir and not Path(folder).exists():
        Path(folder).mkdir(parents=True)
        print(f"Created {folder}.", flush=True)
    if not Path(folder).is_dir():
        raise TendError(f"{folder} isn't a folder. To create it, add --mkdir.")
    app = None
    if opts.app:
        app = app_by_id(cfg, opts.app)
        if not app:
            raise TendError(f"no app with ID '{opts.app}'. Run `tend apps` to see them.")
    command = opts.command or (shlex.join(opts.after_dashes) if opts.after_dashes else (app or {}).get("launch"))
    if app and not command:
        raise TendError(f"'{app['id']}' has no launch command. Give one after --.")
    base = session_name(opts.name or Path(folder).name)
    if setup:
        run_setup(setup, folder)
    with edit_config() as fresh:
        session = {
            "name": unique_name(fresh, base),
            "dir": folder,
            "command": command,
            "autostart": not opts.no_autostart,
        }
        if opts.no_restore_conversation:
            session["restore_conversation"] = False
        fresh[SESSIONS_KEY].append(session)
    print(start(cfg, session))
    note = app and app.get("preflight") and preflight(app["preflight"], folder, session["name"])
    if note:
        print(note)


def cmd_add(cfg, opts):
    folder = str(Path(opts.dir).expanduser().resolve())
    name = session_name(opts.name or Path(folder).name)
    rows = status(cfg) if not opts.after_dashes and has_session(name) else None
    with edit_config() as fresh:
        if find(fresh, name):
            raise TendError(f"'{name}' is already tracked. Remove it first with `tend rm {name}`.")
        if rows is not None:
            session = adopt(fresh, name, rows)
            if opts.no_restore_conversation:
                session["restore_conversation"] = False
                session.pop("resume", None)
        else:
            session = {
                "name": name,
                "dir": folder,
                "command": shlex.join(opts.after_dashes) if opts.after_dashes else None,
                "autostart": not opts.no_autostart,
            }
            if opts.no_restore_conversation:
                session["restore_conversation"] = False
            fresh[SESSIONS_KEY].append(session)
    print(f"Tracking '{name}'.")
    if opts.start:
        print(start(cfg, session))


def cmd_snapshot(cfg, opts):
    rows = status(cfg)
    names = opts.names or [r["name"] for r in rows if not r["managed"]]
    with edit_config() as fresh:
        added = [entry for entry in (adopt(fresh, name, rows) for name in names) if entry]
    for entry in added:
        print(f"Tracking '{entry['name']}': {entry.get('resume') or entry['command'] or '(shell)'}")
    if not added:
        print("Every running session is already tracked.")


def cmd_rm(cfg, opts):
    need(cfg, opts.name)
    if opts.stop:
        print(stop(opts.name))
    with edit_config() as fresh:
        fresh[SESSIONS_KEY] = [s for s in fresh[SESSIONS_KEY] if s["name"] != opts.name]
    forget_live(opts.name)
    print(f"Stopped tracking '{opts.name}'.")


def cmd_start(cfg, opts):
    print(start(cfg, need(cfg, opts.name), opts.fresh))


def cmd_stop(cfg, opts):
    print(stop(opts.name))
    forget_live(opts.name)


def cmd_restart(cfg, opts):
    need(cfg, opts.name)
    if current_session() == opts.name:
        hand_off(["restart", opts.name] + (["--fresh"] if opts.fresh else []))
        print(f"Restarting '{opts.name}', the session this runs in. It closes now and starts again shortly.")
        return
    out = stop_for_restart(cfg, opts.name)
    if out:
        print(out)
    # stop_for_restart saved the latest resume command into cfg.
    print(start(cfg, need(cfg, opts.name), opts.fresh))


def cmd_history(cfg, opts):
    need(cfg, opts.name)
    entries = history_for(opts.name)
    if opts.json:
        print_json(entries)
    elif not entries:
        print(f"No conversations recorded for '{opts.name}' yet.")
    else:
        for entry in entries:
            print(f"{entry['id']}  {ago(entry['last_seen']):>16}  {entry.get('label') or ''}")


def cmd_resume(cfg, opts):
    session = need(cfg, opts.name)
    # The app running in the session, or else the first app that can reattach.
    row = next((r for r in status(cfg) if r["name"] == opts.name), None)
    app = row and row["app"] and app_by_id(cfg, row["app"]["id"])
    app = app or next((a for a in apps(cfg) if a.get("reattach")), None)
    if not app or not app.get("reattach"):
        raise TendError(f"tend doesn't know how to bring back a conversation in '{opts.name}'.")
    entries = history_for(opts.name)
    conversation = opts.id or (entries[0]["id"] if entries else None)
    if not conversation:
        raise TendError(f"no conversations recorded for '{opts.name}'. Give an ID.")
    if current_session() == opts.name:
        hand_off(["resume", opts.name, conversation])
        print(
            f"Resuming {conversation} in '{opts.name}', the session this runs in. "
            "It closes now and starts again shortly."
        )
        return
    if has_session(opts.name):
        out = stop_for_restart(cfg, opts.name)
        if out:
            print(out)
    command = app["reattach"].format(id=conversation)
    print(start(cfg, session, command=command), flush=True)
    code, message = wait(cfg, opts.name, 60, command=command)
    if code == 1 and session.get("command"):
        # Remote Control can't reattach to a conversation whose environment
        # is gone, as after a reboot. Start the session the usual way, and
        # offer the conversation to recover.
        print(f"tend: couldn't bring back {conversation}.\n{message}", file=sys.stderr)
        type_command(opts.name, session["command"])
        print(f"Started '{opts.name}' again: {session['command']}")
        entry = next((e for e in entries if e["id"] == conversation), {"id": conversation})
        if drop_conversation(cfg, opts.name, entry):
            print(f"To reopen the conversation in its own session, run `tend recover {opts.name} {conversation}`.")


def cmd_dropped(cfg, opts):
    entries = dropped_list()
    if opts.json:
        print_json(entries)
    elif not entries:
        print("No dropped conversations.")
    else:
        for entry in entries:
            print(f"{entry['session']:<16} {entry['id']}  {ago(entry['dropped_at']):>16}  {entry.get('label') or ''}")


def cmd_recover(cfg, opts):
    entry = next(
        (d for d in dropped_list(settled=False) if d["id"] == opts.id and d["session"] == opts.name),
        None,
    ) or next((e for e in history_for(opts.name) if e["id"] == opts.id and e.get("recover")), None)
    if not entry:
        raise TendError(f"'{opts.name}' has no dropped conversation {opts.id}. Run `tend dropped` to see them.")
    folder = entry.get("dir") or need(cfg, opts.name)["dir"]
    base = session_name(opts.as_name or entry.get("label") or f"{opts.name}-chat")
    with edit_config() as fresh:
        session = {"name": unique_name(fresh, base), "dir": folder, "command": entry["recover"], "autostart": False}
        fresh[SESSIONS_KEY].append(session)
    print(start(cfg, session))
    with contextlib.suppress(TendError):
        dismiss(opts.name, opts.id)
    name = session["name"]
    print(f"'{name}' doesn't start when tend restores sessions. Turn that on with `tend autostart {name} on`.")


def cmd_dismiss(cfg, opts):
    if not opts.all and not opts.id:
        raise TendError("give a conversation ID, or --all.")
    n = dismiss(None, None) if opts.all else dismiss(opts.name, opts.id)
    print(f"Dismissed {n} dropped conversation{'s' if n != 1 else ''}.")


def cmd_restore(cfg, opts):
    if opts.once and restored_this_boot():
        print("Already restored since the Mac started. Nothing to do.")
        return
    mark_restored()
    todo = [s for s in cfg[SESSIONS_KEY] if s.get("autostart", True) and not has_session(s["name"])]
    for session in todo:
        try:
            print(start(cfg, session))
        except TendError as e:
            print(f"tend: couldn't start '{session['name']}': {e}", file=sys.stderr)
    if not todo:
        print("Every session that's set to restore is running.")


def cmd_autostart(cfg, opts):
    with edit_config() as fresh:
        need(fresh, opts.name)["autostart"] = opts.value == "on"
    print(f"Autostart for '{opts.name}' is {opts.value}.")


def cmd_restore_conversation(cfg, opts):
    on = opts.value == "on"
    with edit_config() as fresh:
        session = need(fresh, opts.name)
        if on:
            session.pop("restore_conversation", None)
        else:
            session["restore_conversation"] = False
            # The saved resume command and the dropped list are about the
            # conversation, so they go too.
            session.pop("resume", None)
    if not on:
        forget_live(opts.name)
        dismiss_session(opts.name)
        print(f"'{opts.name}' starts its plain command, and tend doesn't bring back its conversations.")
    else:
        print(f"tend brings back the conversation in '{opts.name}' when it restarts.")


def cmd_apps(cfg, opts):
    by_id = {app["id"]: app for app in apps(cfg)}

    if opts.action == "ls":
        if opts.json:
            print_json(list(by_id.values()))
            return
        for app in by_id.values():
            rules = app.get("match", {})
            patterns = ", ".join(rules.get("names", []) + rules.get("paths", []))
            flags = ("" if app["enabled"] else " (off)") + (" (built in)" if app["builtin"] else "")
            print(f"{app['id']:<12} {app.get('name', app['id'])}{flags}: {patterns}")
        return

    if not opts.target:
        raise TendError(f"`tend apps {opts.action}` needs an app ID or program.")

    if opts.action == "add":
        target = opts.target
        path = shutil.which(target) if "/" not in target else os.path.expanduser(target)
        if not path or not os.path.exists(path):
            raise TendError(f"can't find a program named '{target}'.")
        real = os.path.realpath(path)
        app_id = opts.id or re.sub(r"[^a-z0-9-]+", "-", Path(target).name.lower()).strip("-")
        if app_id in by_id:
            raise TendError(f"there's already an app with ID '{app_id}'. Pick another with --id.")
        names = sorted({Path(path).name, Path(real).name})
        entry = {"id": app_id, "name": opts.name or Path(path).name, "match": {"names": names, "paths": [real]}}
        if opts.icon:
            entry["icon"] = os.path.expanduser(opts.icon) if opts.icon.startswith("~") else opts.icon
        with edit_config() as fresh:
            fresh.setdefault("apps", []).append(entry)
        print(f"Added '{app_id}'. It matches processes named {', '.join(names)}, or running {real}.")
        return

    if opts.target not in by_id:
        raise TendError(f"no app with ID '{opts.target}'. Run `tend apps` to see them.")

    if opts.action == "rm":
        if by_id[opts.target]["builtin"]:
            raise TendError(f"'{opts.target}' is built in. Turn it off with `tend apps disable {opts.target}`.")
        with edit_config() as fresh:
            fresh["apps"] = [a for a in fresh.get("apps", []) if a["id"] != opts.target]
        print(f"Removed '{opts.target}'.")
        return

    # enable or disable. For a built-in app, the config holds only the change.
    enabled = opts.action == "enable"
    with edit_config() as fresh:
        custom = fresh.setdefault("apps", [])
        entry = next((a for a in custom if a["id"] == opts.target), None)
        if entry is None:
            entry = {"id": opts.target}
            custom.append(entry)
        entry["enabled"] = enabled
    print(f"'{opts.target}' is {'on' if enabled else 'off'}.")


def cmd_recipes(cfg, opts):
    by_id = {r["id"]: r for r in recipes(cfg)}
    if opts.action == "ls":
        if opts.json:
            print_json(list(by_id.values()))
            return
        for r in by_id.values():
            builtin = " (built in)" if r["builtin"] else ""
            print(f"{r['id']:<12} {r.get('name', r['id'])}{builtin}: {r['setup']}")
        return
    if not opts.target:
        raise TendError(f"`tend recipes {opts.action}` needs a recipe ID.")
    if opts.action == "add":
        if not opts.setup:
            raise TendError("`tend recipes add` needs --setup.")
        if opts.target in by_id and by_id[opts.target]["builtin"]:
            raise TendError(f"'{opts.target}' is built in. Pick another ID.")
        entry = {"id": opts.target, "name": opts.name or opts.target, "setup": opts.setup}
        if opts.input:
            entry["input"] = opts.input
        with edit_config() as fresh:
            fresh["recipes"] = [r for r in fresh.get("recipes", []) if r["id"] != opts.target] + [entry]
        print(f"Saved recipe '{opts.target}'.")
        return
    if opts.target not in by_id or by_id[opts.target]["builtin"]:
        raise TendError(f"no saved recipe with ID '{opts.target}'.")
    with edit_config() as fresh:
        fresh["recipes"] = [r for r in fresh.get("recipes", []) if r["id"] != opts.target]
    print(f"Removed recipe '{opts.target}'.")


def cmd_accounts(cfg, opts):
    if opts.action == "add":
        if not opts.user:
            raise TendError("give a user name. Run `tend accounts` to see them.")
        users = local_users()
        if opts.user not in users:
            raise TendError(f"no other account named '{opts.user}'. Accounts: {', '.join(users) or 'none'}.")
        with edit_config() as fresh:
            watched = fresh.setdefault("accounts", [])
            if opts.user not in watched:
                watched.append(opts.user)
        print(f"Watching {users[opts.user]}'s account.")
        return
    if opts.action == "rm":
        with edit_config() as fresh:
            watched = fresh.setdefault("accounts", [])
            if opts.user not in watched:
                raise TendError(f"'{opts.user}' isn't on the list.")
            watched.remove(opts.user)
        print(f"Stopped watching {full_name(opts.user)}'s account.")
        return

    watched = cfg.get("accounts", [])
    statuses = [account_status(u) for u in watched]
    if opts.json:
        available = [{"user": u, "name": n} for u, n in local_users().items() if u not in watched]
        print_json({"watched": statuses, "available": available})
        return
    if not statuses:
        print("No accounts watched. Add one with `tend accounts add USER`.")
    for account in statuses:
        print(f"{account['user']}: {account['problem'] or 'Tend is running.'}")


def cmd_answer(cfg, opts):
    print(answer(cfg, opts.name, opts.answer))


def cmd_wait(cfg, opts):
    code, message = wait(cfg, opts.name, opts.timeout)
    print(message)
    sys.exit(code)


def cmd_folders(cfg, opts):
    found = folders(cfg)
    if opts.json:
        print_json(found)
        return
    for title in ("recent", "nearby", "parents"):
        print(f"{title.capitalize()}:")
        for folder in found[title]:
            print("  " + short_path(folder))


def cmd_attach(cfg, opts):
    if not has_session(opts.name):
        raise TendError(f"'{opts.name}' isn't running.")
    verb = "switch-client" if os.environ.get("TMUX") else "attach"
    os.execvp("tmux", ["tmux", verb, "-t", f"={opts.name}"])


def cmd_open(cfg, opts):
    open_in_terminal(cfg, opts.name)


def cmd_terminal(cfg, opts):
    if opts.app is not None or opts.attach is not None:
        with edit_config() as fresh:
            set_terminal(fresh, opts.app, opts.attach)
        cfg = fresh
    settings = terminal_settings(cfg)
    if opts.json:
        print_json(settings)
    else:
        print(f"App:    {settings['app']}")
        preset = f"  ({settings['mode']})" if settings["mode"] != "custom" else ""
        print(f"Attach: {settings['attach']}{preset}")


def cmd_config(cfg, opts):
    paths = {"config": str(CONFIG), "state": str(STATE)}
    if opts.json:
        print_json(paths)
    else:
        print(f"Config: {paths['config']}")
        print(f"State:  {paths['state']}")


NO_RESTORE_HELP = "start the plain command every time, and don't record or bring back conversations"


def build_parser():
    parser = argparse.ArgumentParser(prog="tend", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)

    def command(name, func, **kwargs):
        sp = sub.add_parser(name, **kwargs)
        sp.set_defaults(func=func)
        return sp

    sp = command("ls", cmd_ls, aliases=["status"], help="list sessions")
    sp.add_argument("--json", action="store_true")

    sp = command("add", cmd_add, help="track a session")
    sp.add_argument("name", nargs="?")
    sp.add_argument("--dir", default=os.getcwd())
    sp.add_argument("--no-autostart", action="store_true")
    sp.add_argument("--no-restore-conversation", action="store_true", help=NO_RESTORE_HELP)
    sp.add_argument("--start", action="store_true")

    sp = command("new", cmd_new, help="track and start a new session")
    sp.add_argument("app", nargs="?")
    sp.add_argument("--dir", default=os.getcwd())
    sp.add_argument("--name")
    sp.add_argument("--no-autostart", action="store_true")
    sp.add_argument("--no-restore-conversation", action="store_true", help=NO_RESTORE_HELP)
    sp.add_argument("--command", help="a shell command, typed into the session as is")
    sp.add_argument("--mkdir", action="store_true", help="create the folder if it doesn't exist")
    sp.add_argument("--setup", help="a shell command to run in the folder once, before the app starts")
    sp.add_argument("--recipe", help="a saved setup, from `tend recipes`")
    sp.add_argument("--input", help="the text for the recipe's {input}, like a repository URL")

    sp = command("recipes", cmd_recipes, help="list or change saved setups for `tend new`")
    sp.add_argument("action", nargs="?", choices=["ls", "add", "rm"], default="ls")
    sp.add_argument("target", nargs="?", help="a recipe ID")
    sp.add_argument("--setup", help="for add: the shell command, with {input} for the text")
    sp.add_argument("--name")
    sp.add_argument("--input", help="for add: a label for the text {input} stands for")
    sp.add_argument("--json", action="store_true")

    sp = command("dropped", cmd_dropped, help="list conversations dropped when their session restarted")
    sp.add_argument("--json", action="store_true")

    sp = command("recover", cmd_recover, help="reopen a dropped conversation in a new session")
    sp.add_argument("name", help="the session the conversation ran in")
    sp.add_argument("id", help="a conversation ID from `tend dropped`")
    sp.add_argument("--as", dest="as_name", help="a name for the new session (default: the conversation's)")

    sp = command("dismiss", cmd_dismiss, help="take a conversation off the dropped list")
    sp.add_argument("name", nargs="?")
    sp.add_argument("id", nargs="?")
    sp.add_argument("--all", action="store_true", help="dismiss every dropped conversation")

    sp = command("wait", cmd_wait, help="wait until a session is ready, asks a question, or exits")
    sp.add_argument("name")
    sp.add_argument("--timeout", type=int, default=90, help="seconds to wait (default 90)")

    sp = command("answer", cmd_answer, help="answer the question a session is waiting on")
    sp.add_argument("name")
    sp.add_argument("answer")

    sp = command("folders", cmd_folders, help="suggest folders for a new session")
    sp.add_argument("--json", action="store_true")

    sp = command("snapshot", cmd_snapshot, help="track running tmux sessions")
    sp.add_argument("names", nargs="*")

    sp = command("rm", cmd_rm, help="stop tracking a session")
    sp.add_argument("name")
    sp.add_argument("--stop", action="store_true", help="close its tmux session too")

    for name, func in (("start", cmd_start), ("restart", cmd_restart)):
        sp = command(name, func, help=f"{name} a tracked session")
        sp.add_argument("name")
        sp.add_argument("--fresh", action="store_true", help="run the saved command, not the resume command")

    for name, func, text in (
        ("stop", cmd_stop, "close a session's tmux session"),
        ("attach", cmd_attach, "attach to a session in this terminal"),
        ("open", cmd_open, "open a session in a new terminal window"),
    ):
        command(name, func, help=text).add_argument("name")

    sp = command("history", cmd_history, help="list the conversations a session has run")
    sp.add_argument("name")
    sp.add_argument("--json", action="store_true")

    sp = command("resume", cmd_resume, help="bring back a past conversation in a session")
    sp.add_argument("name")
    sp.add_argument("id", nargs="?", help="a conversation ID from `tend history` (default: the latest)")

    sp = command("restore", cmd_restore, help="start every session that's set to restore")
    sp.add_argument("--once", action="store_true", help="do nothing if tend already restored since the Mac started")

    sp = command("apps", cmd_apps, help="list or change the apps tend recognizes")
    sp.add_argument("action", nargs="?", choices=["ls", "add", "rm", "enable", "disable"], default="ls")
    sp.add_argument("target", nargs="?", help="an app ID, or for add, a program name or path")
    sp.add_argument("--id")
    sp.add_argument("--name")
    sp.add_argument("--icon", help="for add: a bundle ID, or a .app or image path")
    sp.add_argument("--json", action="store_true")

    sp = command("terminal", cmd_terminal, help="show or change how `tend open` opens a session")
    sp.add_argument("--app", help=f"the terminal app: {' or '.join(TERMINALS)}")
    sp.add_argument("--attach", help=f"a preset ({', '.join(ATTACH_PRESETS)}) or a command with {{target}} or {{name}}")
    sp.add_argument("--json", action="store_true")

    sp = command("accounts", cmd_accounts, help="watch other accounts on this Mac, to check that Tend runs there")
    sp.add_argument("action", nargs="?", choices=["ls", "add", "rm"], default="ls")
    sp.add_argument("user", nargs="?", help="the account's short user name")
    sp.add_argument("--json", action="store_true")

    sp = command("autostart", cmd_autostart, help="turn restore on or off for a session")
    sp.add_argument("name")
    sp.add_argument("value", choices=["on", "off"])

    sp = command(
        "restore-conversation",
        cmd_restore_conversation,
        help="choose whether tend brings back a session's conversation when it restarts",
    )
    sp.add_argument("name")
    sp.add_argument("value", choices=["on", "off"])

    sp = command("config", cmd_config, help="show where tend keeps its files")
    sp.add_argument("--json", action="store_true")

    return parser


def main(argv=None):
    args = sys.argv[1:] if argv is None else argv
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    # Everything after -- is a command for the session, not tend's options.
    after_dashes = []
    if "--" in args:
        i = args.index("--")
        args, after_dashes = args[:i], args[i + 1:]
    opts = build_parser().parse_args(args)
    opts.after_dashes = after_dashes
    opts.func(load(), opts)


if __name__ == "__main__":
    try:
        main()
    except TendError as e:
        print(f"tend: {e}", file=sys.stderr)
        sys.exit(1)
